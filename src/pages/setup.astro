---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import UpdateBanner from '../components/UpdateBanner.astro';
import SectionBlock from '../components/SectionBlock.astro';
import SelectionBar from '../components/SelectionBar.astro';
import ScriptSheet from '../components/ScriptSheet.astro';
import CommandPeek from '../components/CommandPeek.astro';
import CommandSearch from '../components/CommandSearch.astro';
import ControllerHints from '../components/ControllerHints.astro';
import { PRESETS, STAGES, matchPattern } from '../lib/stages';

const all = await getCollection('commands');
all.sort((a, b) => a.data.order - b.data.order);

const entriesByStage = new Map(
	STAGES.map((s) => [s.id, all.filter((e) => e.data.category === s.id)]),
);

const spellbookEntries = await getCollection('spellbook');
spellbookEntries.sort((a, b) => a.data.order - b.data.order);

const allCommandIds = all.map((entry) => entry.id);
const presetCards = PRESETS.map((preset) => ({
	...preset,
	count: allCommandIds.filter((id) =>
		preset.patterns.some((pattern) => matchPattern(id, pattern)),
	).length,
	patternsAttr: preset.patterns.join('|'),
}));
---

<Base
	title="magus.sh — Steam Deck setup"
	description="Pick a Steam Deck setup, review the script, and copy one command into Konsole."
>
	<div class="page-shell relative mx-auto max-w-7xl px-5 pt-5 sm:pt-6">
		<aside class="page-rail rise rise-2" aria-label="Magus controls">
			<header class="rail-brand">
				<h1 class="rail-title" style="font-family: var(--font-serif);">
					Steam Deck <em class="rail-title-em">setup.</em>
				</h1>
				<p class="rail-sub">pick what you want. copy one command.</p>
			</header>

			<div class="device-mode" aria-label="Device mode">
				<a class="device-mode-card is-active" href="/setup" aria-current="page">
					<Icon name="simple-icons:steamdeck" class="device-mode-icon" />
					<span>
						<strong>Steam Deck</strong>
						<small>Ready now</small>
					</span>
				</a>
				<a class="device-mode-card" href="/mac">
					<Icon name="simple-icons:apple" class="device-mode-icon" />
					<span>
						<strong>Mac</strong>
						<small>Beta</small>
					</span>
				</a>
			</div>

			<ol class="setup-flow" aria-label="Setup flow">
				<li><span>1</span> Pick</li>
				<li><span>2</span> Review</li>
				<li><span>3</span> Copy</li>
			</ol>

			<section class="preset-panel" aria-labelledby="preset-heading">
				<div class="rail-section-head">
					<h2 id="preset-heading">Start from a preset</h2>
					<span>optional</span>
				</div>
				<div class="preset-grid">
					{
						presetCards.map((preset) => (
							<button
								type="button"
								class="preset-card"
								data-preset-id={preset.id}
								data-preset-patterns={preset.patternsAttr}
								aria-label={`Apply ${preset.name} preset`}
							>
								<span class="preset-card-copy">
									<strong>{preset.name}</strong>
									<small>{preset.tagline}</small>
								</span>
								<span class="preset-card-count">{preset.count}</span>
							</button>
						))
					}
				</div>
			</section>

			<div class="rail-tools">
				<div class="rail-section-head">
					<h2>Find commands</h2>
					<span>/</span>
				</div>
				<CommandSearch />
			</div>

			<nav
				class="stage-tabs items-center text-sm"
				aria-label="Stages"
				role="tablist"
			>
				{
					STAGES.map((c) => (
						<a
							href={`#${c.id}`}
							role="tab"
							data-stage={c.id}
							data-stage-tab-id={c.id}
							aria-controls={c.id}
							aria-selected="false"
							class="stage-tab group relative inline-flex items-center gap-3 rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface)] py-1.5 pl-3 pr-4 text-[color:var(--color-text)] hover:border-[color:var(--color-accent)] aria-selected:border-[color:var(--color-accent)] aria-selected:bg-[color:var(--color-accent)]/5"
						>
							<span class="stage-tab-progress" aria-hidden="true"></span>
							<span class="font-mono text-[10px] tracking-wider text-[color:var(--color-text-dim)] transition-colors group-hover:text-[color:var(--color-accent)] group-aria-selected:text-[color:var(--color-accent)]">
								{c.num}
							</span>
							<span class="stage-tab-label font-medium transition-colors group-hover:text-[color:var(--color-accent)] group-aria-selected:text-[color:var(--color-accent)]">
								{c.short}
							</span>
							<span class="stage-tab-count font-mono text-[10px] text-[color:var(--color-text-dim)] tabular-nums" data-stage-count={c.id}></span>
						</a>
					))
				}
			</nav>

			<UpdateBanner />
		</aside>

		<div class="page-content">
		{
			STAGES.map((stage) => (
				<SectionBlock
					id={stage.id}
					number={stage.num}
					stageLabel={stage.stageLabel}
					title={stage.title}
					tagline={stage.tagline}
					entries={entriesByStage.get(stage.id) ?? []}
					rise={stage.rise}
					variant={'variant' in stage ? stage.variant : undefined}
				/>
			))
		}

		<details class="rise rise-5 spellbook mt-16" aria-labelledby="spellbook-heading">
			<summary class="spellbook-summary">
				<span
					class="spellbook-kicker font-mono text-[10px] uppercase tracking-[0.28em] text-[color:var(--color-accent-dim)]"
				>
					/ future spells
				</span>
				<span class="spellbook-rule h-px flex-1"></span>
				<h2
					id="spellbook-heading"
					class="spellbook-heading"
				>
					Still being conjured.
				</h2>
				<span class="spellbook-meta font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-text-dim)]">
					{spellbookEntries.length} drafts
				</span>
				<span class="spellbook-marker" aria-hidden="true">+</span>
			</summary>

			<ul class="spellbook-grid mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{
					spellbookEntries.map((spell) => (
						<li class="spell-card" data-status={spell.data.status}>
							<div class="spell-card-head">
								<Icon name={spell.data.icon} class="spell-card-icon" />
								<span class="spell-status">
									<span class="spell-status-dot" aria-hidden="true" />
									{spell.data.status}
								</span>
							</div>
							<h3 class="spell-card-title">{spell.data.title}</h3>
							<p class="spell-card-teaser">{spell.data.teaser}</p>
						</li>
					))
				}
			</ul>
		</details>
		</div>
	</div>

	<SelectionBar />
	<ScriptSheet />
	<CommandPeek />
	<ControllerHints />
</Base>

<script>
	import { isStage, type Stage } from '../lib/stages';

	const reduced = () =>
		window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const runActivate = (stage: Stage, opts: { scroll?: boolean }) => {
		document
			.querySelectorAll<HTMLElement>('section.stage')
			.forEach((sec) => {
				sec.hidden = sec.id !== stage;
			});
		document
			.querySelectorAll<HTMLAnchorElement>('a[role="tab"][data-stage]')
			.forEach((tab) => {
				tab.setAttribute(
					'aria-selected',
					tab.dataset.stage === stage ? 'true' : 'false',
				);
			});
		if (opts.scroll) {
			requestAnimationFrame(() => {
				document.getElementById(stage)?.scrollIntoView({
					behavior: reduced() ? 'auto' : 'smooth',
					block: 'start',
				});
			});
		}
	};

	const activate = (stage: Stage, opts: { scroll?: boolean } = {}) => {
		/* Don't switch stages while a search is active — search shows all stages. */
		if (document.documentElement.classList.contains('searching')) {
			runActivate(stage, opts);
			return;
		}
		/* Use View Transitions when available for a soft cross-fade between stages. */
		const startVT = (
			document as Document & {
				startViewTransition?: (cb: () => void) => unknown;
			}
		).startViewTransition;
		if (startVT && !reduced()) {
			startVT.call(document, () => runActivate(stage, opts));
		} else {
			runActivate(stage, opts);
		}
	};

	const fromHash = (): Stage => {
		const h = location.hash.slice(1);
		return isStage(h) ? h : 'setup';
	};

	document
		.querySelectorAll<HTMLAnchorElement>('a[role="tab"][data-stage]')
		.forEach((tab) => {
			tab.addEventListener('click', (e) => {
				e.preventDefault();
				const stage = tab.dataset.stage;
				if (!stage || !isStage(stage)) return;
				const newHash = `#${stage}`;
				if (location.hash !== newHash) {
					history.pushState(null, '', newHash);
				}
				activate(stage, { scroll: true });
			});
		});

	window.addEventListener('hashchange', () => {
		activate(fromHash(), { scroll: true });
	});

	activate(fromHash());
</script>

<style>
	/* view transition: dissolve stages on tab switch */
	::view-transition-old(stages),
	::view-transition-new(stages) {
		animation-duration: 0.28s;
	}
	section.stage:not([hidden]) {
		view-transition-name: stages;
	}

	.rail-section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
		margin-bottom: 8px;
	}
	.rail-section-head h2 {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-text-dim);
	}
	.rail-section-head span {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.device-mode {
		display: grid;
		grid-template-columns: 1fr;
		gap: 7px;
	}
	.device-mode-card {
		position: relative;
		display: grid;
		grid-template-columns: 28px minmax(0, 1fr);
		align-items: center;
		gap: 10px;
		min-height: 48px;
		padding: 9px 10px;
		border: 1px solid color-mix(in oklab, var(--color-border) 74%, transparent);
		border-radius: 8px;
		background: color-mix(in oklab, var(--color-bg) 52%, transparent);
		color: inherit;
		text-decoration: none;
	}
	.device-mode-card.is-active {
		border-color: color-mix(in oklab, var(--color-accent) 56%, var(--color-border));
		background: color-mix(in oklab, var(--color-accent) 9%, transparent);
	}
	.device-mode-card.is-active::after {
		content: '';
		position: absolute;
		top: 10px;
		right: 10px;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 12px var(--color-accent);
	}
	.device-mode-card:not(.is-active):hover {
		border-color: color-mix(in oklab, var(--color-accent) 50%, var(--color-border));
		background: color-mix(in oklab, var(--color-accent) 7%, transparent);
	}
	.device-mode-icon {
		width: 18px;
		height: 18px;
		color: var(--color-accent);
	}
	.device-mode-card strong,
	.device-mode-card small {
		display: block;
		line-height: 1.15;
	}
	.device-mode-card strong {
		font-size: 0.86rem;
		font-weight: 500;
		color: var(--color-text);
	}
	.device-mode-card small {
		margin-top: 3px;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-dim);
	}

	.setup-flow {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.setup-flow li {
		display: grid;
		gap: 5px;
		padding: 8px 7px;
		border: 1px solid color-mix(in oklab, var(--color-border) 68%, transparent);
		border-radius: 8px;
		background: color-mix(in oklab, var(--color-bg) 42%, transparent);
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}
	.setup-flow span {
		color: var(--color-accent);
		font-size: 9px;
	}

	.preset-panel {
		display: grid;
		gap: 0;
	}
	.preset-grid {
		display: grid;
		gap: 7px;
	}
	.preset-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 10px;
		width: 100%;
		min-height: 54px;
		padding: 10px;
		border: 1px solid color-mix(in oklab, var(--color-border) 78%, transparent);
		border-radius: 8px;
		background: color-mix(in oklab, var(--color-bg) 52%, transparent);
		color: var(--color-text);
		text-align: left;
		cursor: pointer;
		transition:
			border-color 0.18s ease,
			background-color 0.18s ease,
			transform 0.18s ease;
	}
	.preset-card:hover,
	.preset-card:focus-visible {
		border-color: var(--color-accent);
		background: color-mix(in oklab, var(--color-accent) 8%, transparent);
		transform: translateY(-1px);
		outline: none;
	}
	.preset-card[data-applied='true'] {
		border-color: color-mix(in oklab, var(--color-accent) 58%, var(--color-border));
		background: color-mix(in oklab, var(--color-accent) 11%, transparent);
	}
	.preset-card-copy strong,
	.preset-card-copy small {
		display: block;
	}
	.preset-card-copy strong {
		font-size: 0.86rem;
		font-weight: 500;
		line-height: 1.15;
	}
	.preset-card-copy small {
		margin-top: 3px;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-dim);
		line-height: 1.25;
	}
	.preset-card-count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 28px;
		height: 28px;
		border-radius: 999px;
		border: 1px solid color-mix(in oklab, var(--color-border) 78%, transparent);
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-accent);
		background: color-mix(in oklab, var(--color-accent) 8%, transparent);
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		.device-mode,
		.setup-flow,
		.preset-panel {
			grid-column: 1 / -1;
		}
		.device-mode {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.preset-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 639px) {
		.device-mode {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.spellbook {
		position: relative;
	}
	.spellbook[open] .spellbook-marker {
		transform: rotate(45deg);
	}
	.spellbook-summary {
		display: flex;
		align-items: center;
		gap: 12px;
		list-style: none;
		cursor: pointer;
		padding: 6px 2px;
		border-radius: 8px;
		transition: background-color 0.2s ease;
	}
	.spellbook-summary::-webkit-details-marker {
		display: none;
	}
	.spellbook-summary:hover {
		background: color-mix(in oklab, var(--color-surface) 35%, transparent);
	}
	.spellbook-heading {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 400;
		font-size: 1rem;
		line-height: 1.1;
		letter-spacing: -0.005em;
		color: var(--color-text);
		margin: 0;
	}
	.spellbook-rule {
		flex: 1;
		min-width: 24px;
		background: linear-gradient(
			to right,
			var(--color-border),
			color-mix(in oklab, var(--color-accent) 25%, transparent),
			transparent
		);
	}
	.spellbook-marker {
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1;
		color: var(--color-accent);
		transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		flex-shrink: 0;
	}

	.spellbook-grid {
		--card-pad: 1rem;
	}

	.spell-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 0.95rem 1rem 1rem;
		border-radius: 10px;
		border: 1px dashed var(--color-border);
		background: color-mix(in oklab, var(--color-bg-elevated) 55%, transparent);
		transition:
			border-color 0.22s ease,
			transform 0.22s ease,
			background 0.22s ease;
		overflow: hidden;
		isolation: isolate;
	}
	.spell-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(
			circle at 100% 0%,
			color-mix(in oklab, var(--color-accent) 12%, transparent) 0%,
			transparent 55%
		);
		opacity: 0;
		transition: opacity 0.22s ease;
		pointer-events: none;
		z-index: -1;
	}
	.spell-card:hover {
		border-color: color-mix(in oklab, var(--color-accent) 70%, var(--color-border));
		transform: translateY(-2px);
		background: color-mix(in oklab, var(--color-bg-elevated) 75%, transparent);
	}
	.spell-card:hover::before {
		opacity: 1;
	}

	.spell-card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.spell-card-icon {
		width: 18px;
		height: 18px;
		color: var(--color-accent);
		opacity: 0.78;
		transition: opacity 0.22s ease, transform 0.22s ease;
	}
	.spell-card:hover .spell-card-icon {
		opacity: 1;
		transform: scale(1.08);
	}

	.spell-status {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 9px;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--color-text-dim);
	}
	.spell-status-dot {
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: var(--color-text-dim);
	}
	[data-status='planned'] .spell-status-dot {
		background: var(--color-accent);
		box-shadow: 0 0 6px color-mix(in oklab, var(--color-accent) 55%, transparent);
	}
	[data-status='planned'] .spell-status {
		color: color-mix(in oklab, var(--color-accent) 70%, var(--color-text-dim));
	}
	[data-status='research'] .spell-status-dot {
		background: var(--color-warn);
		box-shadow: 0 0 6px color-mix(in oklab, var(--color-warn) 55%, transparent);
	}
	[data-status='research'] .spell-status {
		color: color-mix(in oklab, var(--color-warn) 60%, var(--color-text-dim));
	}
	[data-status='draft'] .spell-status-dot {
		background: var(--color-text-dim);
	}

	.spell-card-title {
		font-family: var(--font-sans);
		font-size: 0.98rem;
		font-weight: 500;
		line-height: 1.2;
		color: var(--color-text);
		letter-spacing: -0.005em;
	}
	.spell-card-teaser {
		font-size: 0.8rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.spellbook-sparkle,
		.spell-card,
		.spell-card-icon,
		.spell-card::before {
			animation: none;
			transition: none;
		}
	}
</style>
