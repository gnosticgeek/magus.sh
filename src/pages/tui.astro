---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { STAGES, STAGE_SIGILS, STAGE_GROUPS, PRESETS } from '../lib/stages';

const all = await getCollection('commands');
all.sort((a, b) => a.data.order - b.data.order);

const stages = STAGES.map((s) => ({
	id: s.id,
	num: s.num,
	short: s.short,
	tagline: s.tagline,
	sigil: STAGE_SIGILS[s.id]?.char ?? '·',
	items: all
		.filter((e) => e.data.category === s.id)
		.map((e) => ({
			id: e.id,
			title: e.data.title,
			summary: e.data.summary ?? '',
			danger: e.data.danger ?? 'low',
			deckOnly: e.data.deck_only ?? false,
			commands: (e.data.commands ?? []).map((c) => ({
				run: c.run,
				description: c.description ?? '',
			})),
		})),
})).filter((s) => s.items.length > 0);

const totalCount = stages.reduce((n, s) => n + s.items.length, 0);
---

<Base
	title="lab/tui — magus.sh"
	description="Interactive prototype of the magus.sh TUI flow."
>
	<div class="lab">
		<header class="lab-head">
			<p class="lab-kicker">
				<span class="kicker-dot" aria-hidden="true"></span>
				<span>lab</span>
				<span class="sep">·</span>
				<span class="muted">a prototype, not the shipped app</span>
			</p>
			<h1 class="lab-title">
				What does the <em>TUI</em> feel like?
			</h1>
			<p class="lab-lede">
				A click-through prototype of the magus.sh terminal app. Use the
				keyboard (or the rail under the window) — same hotkeys we'd ship.
				Both devices answer the same five questions and converge the same
				manifest; switch device to see where their opinions diverge.
			</p>
		</header>

		<div class="lab-layout">
			<section class="lab-main">
				<div class="device-switch" role="radiogroup" aria-label="Device">
					<span class="device-label">device</span>
					<button
						type="button"
						class="device-btn"
						data-device="deck"
						role="radio"
						aria-checked="true"
					>
						<span class="device-name">Steam Deck</span>
						<span class="device-sub">handheld · 32px cursor</span>
					</button>
					<button
						type="button"
						class="device-btn"
						data-device="machine"
						role="radio"
						aria-checked="false"
					>
						<span class="device-name">Steam Machine</span>
						<span class="device-sub">under a TV · 48px, HDMI, CEC</span>
					</button>
					<p class="device-note">
						Same flow, same manifest, different opinions —
						<code>magus</code> branches on DMI, not on a separate build. The
						v0.1 command picker still ships as <code>magus</code> with no
						arguments: <button type="button" class="flow-link" data-flow-toggle
						>show it</button>.
					</p>
				</div>

				<div class="term" data-term>
					<div class="term-chrome">
						<span class="lights" aria-hidden="true">
							<i class="dot red"></i>
							<i class="dot yel"></i>
							<i class="dot grn"></i>
						</span>
						<span class="term-title" data-term-title>magus@deck — bash</span>
						<span class="term-dims">80 × 24</span>
					</div>

					<div class="term-body" data-term-body>
						<div class="screen" data-screen="splash"></div>
						<div class="screen" data-screen="pick" hidden></div>
						<div class="screen" data-screen="review" hidden></div>
						<div class="screen" data-screen="write" hidden></div>
						<div class="screen" data-screen="run" hidden></div>
						<!-- Steam Machine path (v0.2): wizard → manifest → converge → doctor -->
						<div class="screen" data-screen="wizard" hidden></div>
						<div class="screen" data-screen="manifest" hidden></div>
						<div class="screen" data-screen="converge" hidden></div>
						<div class="screen" data-screen="doctor" hidden></div>
						<div class="term-help" data-term-help hidden></div>
					</div>

					<div class="term-status" data-term-status>
						<kbd>←</kbd> <kbd>→</kbd> <span>step</span>
						<span class="sep">·</span>
						<kbd>↑</kbd> <kbd>↓</kbd> <span>move</span>
						<span class="sep">·</span>
						<kbd>enter</kbd> <span>open</span>
						<span class="sep">·</span>
						<kbd>r</kbd> <span>reset</span>
					</div>
				</div>

				<!-- Rebuilt by JS on device change: the two paths have different steps. -->
				<ol class="flow" role="tablist" aria-label="TUI flow steps" data-flow></ol>
			</section>

			<aside class="lab-notes" aria-label="Design notes">
				<div class="state-card" aria-label="Current prototype state">
					<h2 class="notes-title">Live readout</h2>
					<dl class="state-grid">
						<div>
							<dt>screen</dt>
							<dd data-readout-step>splash</dd>
						</div>
						<div>
							<dt>picked</dt>
							<dd><span data-readout-picked>0</span> / {totalCount}</dd>
						</div>
						<div>
							<dt>runtime</dt>
							<dd data-readout-runtime>~0 min</dd>
						</div>
						<div>
							<dt>next key</dt>
							<dd data-readout-action>enter</dd>
						</div>
					</dl>
				</div>

				<h2 class="notes-title">Decision queue</h2>
				<ul class="decision-list">
					<li>
						<span class="decision-tag">Settle</span>
						<strong>The wizard is a manifest builder, nothing more.</strong>
						<small>
							Five questions write <code>manifest.toml</code>, then the
							reconciler takes over. Same file the GUI will read.
						</small>
					</li>
					<li>
						<span class="decision-tag">Prototype</span>
						<strong>Re-running is the normal case, not the exception.</strong>
						<small>
							The Steam Machine path ends on <em>doctor</em> — two months
							later, after an OS update. That's the product.
						</small>
					</li>
					<li>
						<span class="decision-tag">Risk</span>
						<strong>Ghostty and Alacritty aren't wired up in v0.2.</strong>
						<small>
							Picking them yields a step that says so out loud rather than
							silently doing nothing.
						</small>
					</li>
					<li>
						<span class="decision-tag">Prototype</span>
						<strong>Search is global from menu, scoped inside a stage.</strong>
						<small><kbd>/</kbd> opens it; this should map directly to Bubble Tea.</small>
					</li>
					<li>
						<span class="decision-tag">Settle</span>
						<strong>Review before write.</strong>
						<small>Presets can add many commands, so the review gate stays useful.</small>
					</li>
					<li>
						<span class="decision-tag">Risk</span>
						<strong>Pre-flight Deck checks belong before Run.</strong>
						<small>Waydroid and other Deck-only commands should be annotated, not hidden.</small>
					</li>
					<li>
						<span class="decision-tag">Ship</span>
						<strong>Help is in-frame.</strong>
						<small>Press <kbd>?</kbd> anywhere; <kbd>esc</kbd> closes the overlay.</small>
					</li>
				</ul>

				<h2 class="notes-title">Already decided</h2>
				<ul class="notes-list muted">
					<li>Menu-driven by stage, not one long checkbox list.</li>
					<li>Each stage screen has a visible <code>← back</code> row.</li>
					<li><kbd>space</kbd> toggles · <kbd>enter</kbd> activates the focused row.</li>
					<li>Built with Bubble Tea/Lipgloss · scaffold in <code>magus/</code>.</li>
					<li>Outputs an idempotent bash script.</li>
					<li>{totalCount} commands across {stages.length} stages today.</li>
				</ul>
			</aside>
		</div>
	</div>

	<script
		type="application/json"
		id="lab-tui-data"
		set:html={JSON.stringify({ stages, groups: STAGE_GROUPS, presets: PRESETS })}
	></script>
</Base>

<script>
	type Cmd = {
		id: string;
		title: string;
		summary: string;
		danger: 'low' | 'medium' | 'high';
		deckOnly: boolean;
		commands: Array<{ run: string; description: string }>;
	};
	type Stage = {
		id: string;
		num: string;
		short: string;
		tagline: string;
		sigil: string;
		items: Cmd[];
	};
	type Device = 'deck' | 'machine';
	type Step =
		| 'splash' | 'pick' | 'review' | 'write' | 'run'
		| 'wizard' | 'manifest' | 'converge' | 'doctor';

	// One binary, one flow, two sets of opinions (§1). Both devices answer the
	// same five questions and converge the same manifest; only the optimisations
	// differ, because a handheld and a console under a television want different
	// things. Detection picks the opinions on real hardware; here a toggle does.
	const WIZARD_STEPS: Step[] = ['splash', 'wizard', 'manifest', 'converge', 'doctor'];

	// The v0.1 command picker still ships as `magus` with no arguments. It is
	// kept here as a second flow rather than deleted, because it is a real
	// screen the binary can still show.
	const PICKER_STEPS: Step[] = ['splash', 'pick', 'review', 'write', 'run'];
	const ALL_STEPS: Step[] = [
		'splash', 'pick', 'review', 'write', 'run',
		'wizard', 'manifest', 'converge', 'doctor',
	];

	const HOST_BY_DEVICE: Record<Device, string> = {
		deck: 'magus@deck',
		machine: 'magus@steammachine',
	};

	const TITLE_SUFFIX: Record<Step, string> = {
		splash: 'bash',
		pick: 'pick',
		review: 'review',
		write: 'write',
		run: 'done',
		wizard: 'run',
		manifest: 'review',
		converge: 'reconcile',
		doctor: 'doctor',
	};

	type CommandPattern = string;
	type AppGroup = { id: string; name: string; patterns: CommandPattern[] };
	type Preset = { id: string; name: string; tagline: string; patterns: CommandPattern[] };

	const matchPattern = (cmdId: string, pat: CommandPattern): boolean =>
		cmdId.includes(pat);

	const dataEl = document.getElementById('lab-tui-data');
	if (!dataEl?.textContent) throw new Error('lab-tui-data missing');
	const {
		stages,
		groups: STAGE_GROUPS,
		presets: PRESETS,
	} = JSON.parse(dataEl.textContent) as {
		stages: Stage[];
		groups: Partial<Record<string, AppGroup[]>>;
		presets: Preset[];
	};

	const flat: Array<{ stage: Stage; cmd: Cmd }> = [];
	for (const stage of stages) {
		for (const cmd of stage.items) flat.push({ stage, cmd });
	}

	type PickView = 'menu' | 'stage' | 'search' | 'installing';
	type InstallPhase = 'prompt' | 'running' | 'failed' | 'done';

	// ---- Steam Machine path ---------------------------------------------------
	// The wizard's only job is to produce a manifest (§5), so its answers ARE the
	// manifest — there is no separate wizard state to fall out of sync with it.
	type Manifest = {
		terminal: string;
		browser: string;
		bundles: Set<string>;
		theme: string;
		optimise: boolean;
	};

	type Question = {
		id: string;
		title: string;
		prompt: string;
		multi?: boolean;
		options: Array<{ id: string; name: string; note: string }>;
	};

	const QUESTIONS: Question[] = [
		{
			id: 'terminal', title: 'terminal', prompt: 'Which terminal should this machine use?',
			options: [
				{ id: 'kitty', name: 'kitty', note: 'GPU-accelerated · installs to ~/.local' },
				{ id: 'ghostty', name: 'Ghostty', note: 'newer, fast — not wired up in v0.2' },
				{ id: 'alacritty', name: 'Alacritty', note: 'minimal — not wired up in v0.2' },
				{ id: 'konsole', name: 'Keep Konsole', note: 'change nothing' },
			],
		},
		{
			id: 'browser', title: 'browser', prompt: 'Which browser?',
			options: [
				{ id: 'firefox', name: 'Firefox', note: 'open source · the default' },
				{ id: 'brave', name: 'Brave', note: 'chromium, blocks ads by default' },
				{ id: 'chrome', name: 'Google Chrome', note: 'chromium, google account sync' },
				{ id: 'vivaldi', name: 'Vivaldi', note: 'chromium, heavily customisable' },
			],
		},
		{
			id: 'bundles', title: 'apps', prompt: 'Which bundles?', multi: true,
			options: [
				{ id: 'essentials', name: 'Essentials', note: 'archives, editor, media player, images' },
				{ id: 'gaming', name: 'Gaming extras', note: 'ProtonUp-Qt, Heroic, Lutris' },
				{ id: 'creative', name: 'Creative', note: 'GIMP, Krita, Inkscape, OBS' },
				{ id: 'dev', name: 'Dev', note: 'VS Code' },
				{ id: 'comms', name: 'Comms', note: 'Discord, Signal, Element' },
			],
		},
		{
			id: 'optimise', title: 'optimisations', prompt: 'These are not questions — here is what will be done:',
			options: [
				{ id: 'yes', name: 'Apply all five', note: 'full RGB, CEC, performance, Proton-GE, Wi-Fi' },
				{ id: 'no', name: 'Skip optimisations', note: 'leave every display and power default alone' },
			],
		},
		{
			id: 'theme', title: 'theme', prompt: 'Pick a palette. One choice drives everything.',
			options: [
				{ id: 'tokyo-night', name: 'Tokyo Night', note: 'the default' },
				{ id: 'gruvbox', name: 'Gruvbox', note: 'warm, high contrast' },
				{ id: 'catppuccin', name: 'Catppuccin', note: 'soft pastel' },
				{ id: 'nord', name: 'Nord', note: 'cool, muted' },
			],
		},
	];

	// The bundle catalogue, mirroring bundles in magus/steps.go.
	const BUNDLE_APPS: Record<string, string[]> = {
		essentials: ['org.kde.ark', 'org.kde.kate', 'io.mpv.Mpv', 'org.kde.gwenview'],
		gaming: ['net.davidotek.pupgui2', 'com.heroicgameslauncher.hgl', 'net.lutris.Lutris'],
		creative: ['org.gimp.GIMP', 'org.kde.krita', 'org.inkscape.Inkscape', 'com.obsproject.Studio'],
		dev: ['com.visualstudio.code'],
		comms: ['com.discordapp.Discord', 'org.signal.Signal', 'im.riot.Riot'],
	};

	const defaultManifest = (): Manifest => ({
		terminal: 'kitty',
		browser: 'firefox',
		bundles: new Set(['essentials', 'gaming']),
		theme: 'tokyo-night',
		optimise: true,
	});

	const state = {
		device: 'deck' as Device,
		flow: 'wizard' as 'wizard' | 'picker',
		// machine path
		manifest: defaultManifest(),
		questionIndex: 0,
		convergeIndex: 0,
		convergePhase: 'running' as 'running' | 'done',
		convergeRunId: 0,
		driftRepaired: false,

		step: 'splash' as Step,
		cursor: 0,
		picked: new Set<string>(),
		pickView: 'menu' as PickView,
		currentStageId: null as string | null,
		currentGroupId: null as string | null,
		menuCursor: 0,
		searchQuery: '',
		searchResults: [] as Array<{ stage: Stage; cmd: Cmd }>,
		priorView: 'menu' as PickView,
		installedStageIds: new Set<string>(),
		installPhase: 'prompt' as InstallPhase,
		installIndex: 0,
		installLog: [] as Array<{ title: string; result: 'done' | 'skipped' }>,
		notice: null as string | null,
		helpOpen: false,
	};

	const screens = Object.fromEntries(
		ALL_STEPS.map((s) => [
			s,
			document.querySelector<HTMLElement>(`[data-screen="${s}"]`)!,
		]),
	) as Record<Step, HTMLElement>;

	/** Both devices walk the same flow — that is the point of unifying them. */
	const activeSteps = (): Step[] => (state.flow === 'picker' ? PICKER_STEPS : WIZARD_STEPS);

	const termStatus = document.querySelector<HTMLElement>('[data-term-status]')!;
	const helpPanel = document.querySelector<HTMLElement>('[data-term-help]')!;
	const readoutStep = document.querySelector<HTMLElement>('[data-readout-step]')!;
	const readoutPicked = document.querySelector<HTMLElement>('[data-readout-picked]')!;
	const readoutRuntime = document.querySelector<HTMLElement>('[data-readout-runtime]')!;
	const readoutAction = document.querySelector<HTMLElement>('[data-readout-action]')!;

	type Hint = {
		keys: string[];
		label: string;
		kind?: 'primary' | 'normal' | 'system';
	};

	function setStatusHints(hints: Hint[]): void {
		const html = hints
			.map((h) => {
				const kind = h.kind ?? 'normal';
				const keys = h.keys
					.map((k) => `<kbd data-kind="${kind}">${k}</kbd>`)
					.join(' ');
				return `<span class="hint" data-kind="${kind}">${keys} <span>${h.label}</span></span>`;
			})
			.join(`<span class="sep">·</span>`);
		termStatus.innerHTML = html;
	}

	function refreshHints(): void {
		updateReadout();
		const stepHints: Hint[] = [{ keys: ['←', '→'], label: 'step' }];
		const resetHint: Hint = { keys: ['r'], label: 'reset', kind: 'system' };
		if (state.helpOpen) {
			setStatusHints([
				{ keys: ['?', 'esc'], label: 'close help', kind: 'primary' },
				resetHint,
			]);
			return;
		}
		// --- Steam Machine path ---
		if (state.step === 'wizard') {
			const q = QUESTIONS[state.questionIndex];
			setStatusHints([
				...stepHints,
				{ keys: ['↑', '↓'], label: 'choose' },
				q.multi
					? { keys: ['␣'], label: 'toggle', kind: 'primary' as const }
					: { keys: ['↵'], label: 'accept', kind: 'primary' as const },
				...(q.multi ? [{ keys: ['↵'], label: 'continue' }] : []),
				resetHint,
			]);
			return;
		}
		if (state.step === 'manifest') {
			setStatusHints([
				...stepHints,
				{ keys: ['↵'], label: 'write it and converge', kind: 'primary' },
				resetHint,
			]);
			return;
		}
		if (state.step === 'converge') {
			setStatusHints(
				state.convergePhase === 'running'
					? [{ keys: ['…'], label: 'converging' }, resetHint]
					: [...stepHints, { keys: ['→'], label: 'two months later', kind: 'primary' }, resetHint],
			);
			return;
		}
		if (state.step === 'doctor') {
			setStatusHints(
				state.driftRepaired
					? [...stepHints, { keys: ['r'], label: 'reset', kind: 'system' }]
					: [...stepHints, { keys: ['y'], label: 'reconcile & repair', kind: 'primary' }, resetHint],
			);
			return;
		}

		if (state.step === 'splash') {
			setStatusHints([
				...stepHints,
				{ keys: ['↵'], label: 'begin', kind: 'primary' },
				{ keys: ['?'], label: 'help' },
				resetHint,
			]);
		} else if (state.step === 'pick' && state.pickView === 'menu') {
			setStatusHints([
				...stepHints,
				{ keys: ['↑', '↓'], label: 'move' },
				{ keys: ['↵'], label: 'open', kind: 'primary' },
				{ keys: ['/'], label: 'search' },
				{ keys: ['?'], label: 'help' },
				resetHint,
			]);
		} else if (state.step === 'pick' && state.pickView === 'installing') {
			if (state.installPhase === 'running') {
				setStatusHints([{ keys: ['…'], label: 'installing' }, resetHint]);
			} else if (state.installPhase === 'failed') {
				setStatusHints([
					{ keys: ['y'], label: 'retry', kind: 'primary' },
					{ keys: ['s'], label: 'skip' },
					{ keys: ['q'], label: 'abort', kind: 'system' },
				]);
			} else {
				setStatusHints([
					{ keys: ['esc'], label: 'next stage', kind: 'primary' },
					resetHint,
				]);
			}
		} else if (state.step === 'pick' && state.pickView === 'stage') {
			setStatusHints([
				...stepHints,
				{ keys: ['↑', '↓'], label: 'move' },
				{ keys: ['␣'], label: 'toggle', kind: 'primary' },
				{ keys: ['↵'], label: 'select' },
				{ keys: ['esc'], label: 'back' },
				{ keys: ['?'], label: 'help' },
				resetHint,
			]);
		} else if (state.step === 'pick' && state.pickView === 'search') {
			setStatusHints([
				{ keys: ['↑', '↓'], label: 'move' },
				{ keys: ['␣'], label: 'toggle', kind: 'primary' },
				{ keys: ['↵'], label: 'select' },
				{ keys: ['esc'], label: 'back' },
				{ keys: ['?'], label: 'help' },
				resetHint,
			]);
		} else if (state.step === 'review') {
			setStatusHints([
				...stepHints,
				{ keys: ['y'], label: 'write', kind: 'primary' },
				{ keys: ['e'], label: 'edit' },
				{ keys: ['q'], label: 'quit', kind: 'system' },
				{ keys: ['?'], label: 'help' },
				resetHint,
			]);
		} else if (state.step === 'write') {
			setStatusHints([
				...stepHints,
				{ keys: ['↵'], label: 'continue', kind: 'primary' },
				{ keys: ['?'], label: 'help' },
				resetHint,
			]);
		} else if (state.step === 'run') {
			if (state.installPhase === 'prompt') {
				setStatusHints([
					...stepHints,
					{ keys: ['y'], label: 'run now', kind: 'primary' },
					{ keys: ['n'], label: 'paste later' },
					{ keys: ['?'], label: 'help' },
					resetHint,
				]);
			} else if (state.installPhase === 'running') {
				setStatusHints([{ keys: ['…'], label: 'installing' }, resetHint]);
			} else if (state.installPhase === 'failed') {
				setStatusHints([
					{ keys: ['y'], label: 'retry', kind: 'primary' },
					{ keys: ['s'], label: 'skip' },
					{ keys: ['q'], label: 'abort', kind: 'system' },
				]);
			} else {
				setStatusHints([
					...stepHints,
					{ keys: ['↵'], label: 'back to start', kind: 'primary' },
					{ keys: ['?'], label: 'help' },
					resetHint,
				]);
			}
		}
	}

	const renderLines = (lines: string[]): string =>
		lines
			.map((html) => `<div class="line">${html || '&nbsp;'}</div>`)
			.join('');

	let noticeTimer = 0;
	const SPINNER_FRAMES = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];

	function clipText(s: string, width: number): string {
		if (s.length <= width) return s.padEnd(width);
		return `${s.slice(0, Math.max(0, width - 1))}…`;
	}

	function riskLabel(cmd: Cmd): string {
		if (cmd.danger === 'high') return 'HIGH';
		if (cmd.danger === 'medium') return 'MED';
		return 'LOW';
	}

	function riskClass(cmd: Cmd): string {
		if (cmd.danger === 'high') return 't-warn';
		if (cmd.danger === 'medium') return 't-accent';
		return 't-dim';
	}

	function commandEta(cmd: Cmd): string {
		const run = cmd.commands.map((c) => c.run).join('\n');
		if (run.includes('curl') || run.includes('git clone')) return '02m';
		if (run.includes('flatpak install')) return '01m';
		return '<1m';
	}

	function progressPanel(args: {
		title: string;
		done: number;
		total: number;
		current?: { stage?: Stage; cmd: Cmd };
		log: Array<{ title: string; result: 'done' | 'skipped' }>;
		failed?: boolean;
	}): string {
		const pct = args.total > 0 ? Math.round((args.done / args.total) * 100) : 0;
		const barLen = 28;
		const filled = Math.round((pct / 100) * barLen);
		const bar = '█'.repeat(filled) + '░'.repeat(barLen - filled);
		const frame = SPINNER_FRAMES[(args.done + state.installIndex) % SPINNER_FRAMES.length];
		const elapsed = `${String(Math.floor((args.done * 9 + state.installIndex * 3) / 60)).padStart(2, '0')}:${String((args.done * 9 + state.installIndex * 3) % 60).padStart(2, '0')}`;
		const remaining = Math.max(0, args.total - args.done);
		const eta = `${String(Math.max(0, Math.ceil(remaining * 0.4))).padStart(2, '0')}:00`;
		const currentTitle = args.current?.cmd.title ?? 'finalising';
		const currentStage = args.current?.stage?.short ?? 'run';
		const logRows = args.log.slice(-6)
			.map((entry) => {
				const icon = entry.result === 'done'
					? `<span class="t-accent">✓</span>`
					: `<span class="t-dim">—</span>`;
				const title = entry.result === 'skipped'
					? `<span class="t-dim">${esc(entry.title)}</span>`
					: `<span class="t-muted">${esc(entry.title)}</span>`;
				return `<div class="progress-log-row">${icon}<span>${title}</span></div>`;
			})
			.join('');
		const failure = args.failed
			? `<div class="progress-failure">
					<div><span class="t-warn">error</span> <span class="t-dim">connection timed out</span> <span class="t-dim">(simulated)</span></div>
					<div><span class="t-accent">[y]</span> retry   <span class="t-accent">[s]</span> skip this command   <span class="t-accent">[q]</span> abort</div>
				</div>`
			: '';
		return `
			<div class="progress-panel">
				<div class="progress-head">
					<span class="spinner-glyph">${frame}</span>
					<span class="t-bright">${esc(args.title)}</span>
					<span class="progress-percent">${pct}%</span>
				</div>
				<div class="progress-meter"><span style="width:${pct}%"></span></div>
				<div class="progress-bar-line"><span class="t-dim">[</span><span class="t-accent">${bar}</span><span class="t-dim">]</span> <span class="t-dim">${args.done}/${args.total}</span></div>
				<div class="progress-meta">
					<span>elapsed <span class="t-text">${elapsed}</span></span>
					<span>eta <span class="t-text">${eta}</span></span>
					<span>tick <span class="t-text">tea.Tick</span></span>
				</div>
				<div class="progress-current">
					<span class="t-dim">${esc(currentStage)}</span>
					<span class="t-accent">›</span>
					<span class="${args.failed ? 't-warn' : 't-text'}">${esc(currentTitle)}</span>
					${args.failed ? '' : '<span class="cursor-blink">▌</span>'}
				</div>
				<div class="progress-log">${logRows || '<span class="t-dim">waiting for first command…</span>'}</div>
				${failure}
			</div>`;
	}

	function updateReadout(): void {
		if (state.device === 'machine') {
			const steps = plannedSteps().length;
			readoutStep.textContent =
				state.step === 'wizard'
					? `wizard ${state.questionIndex + 1}/${QUESTIONS.length}`
					: state.step;
			readoutPicked.textContent = String(steps);
			readoutRuntime.textContent = `~${Math.max(2, Math.round(steps * 0.9))} min`;
			readoutAction.textContent =
				state.step === 'doctor' && !state.driftRepaired
					? 'y'
					: state.step === 'converge' && state.convergePhase === 'running'
						? 'wait'
						: 'enter';
			return;
		}
		const picked = state.picked.size;
		const runtime = picked === 0 ? '~0 min' : `~${Math.max(2, Math.round(picked * 1.4))} min`;
		const view =
			state.step === 'pick'
				? state.pickView === 'stage'
					? 'pick / stage'
					: `pick / ${state.pickView}`
				: state.step;
		let action = 'enter';
		if (state.helpOpen) action = 'esc';
		else if (state.step === 'pick' && state.pickView === 'stage') action = 'space';
		else if (state.step === 'pick' && state.pickView === 'search') action = 'type';
		else if (state.step === 'review') action = 'y';
		else if (state.step === 'run') action = state.installPhase === 'prompt' ? 'y' : 'enter';
		readoutStep.textContent = view;
		readoutPicked.textContent = String(picked);
		readoutRuntime.textContent = runtime;
		readoutAction.textContent = action;
	}

	function renderHelpPanel(): void {
		if (!state.helpOpen) {
			helpPanel.hidden = true;
			helpPanel.innerHTML = '';
			return;
		}
		const context =
			state.step === 'pick'
				? state.pickView === 'stage'
					? 'Pick Stage'
					: state.pickView === 'search'
						? 'Search'
						: 'Pick Menu'
				: state.step[0]!.toUpperCase() + state.step.slice(1);
		const lines = [
			`<span class="t-accent">?</span> <span class="t-bright">${context} help</span>`,
			'',
			`  <span class="t-accent">↑ ↓</span> <span class="t-muted">move focus</span>`,
			`  <span class="t-accent">enter</span> <span class="t-muted">activate focused row</span>`,
			`  <span class="t-accent">space</span> <span class="t-muted">toggle a command when visible</span>`,
			`  <span class="t-accent">/</span> <span class="t-muted">search all commands, scoped by stage when opened there</span>`,
			`  <span class="t-accent">esc</span> <span class="t-muted">close help or go back</span>`,
			`  <span class="t-accent">r</span> <span class="t-muted">reset prototype state</span>`,
			'',
			`<span class="t-dim">Prototype rule: every key shown here should map to a real Bubble Tea command.</span>`,
		];
		helpPanel.innerHTML = renderLines(lines);
		helpPanel.hidden = false;
	}

	function setNotice(message: string): void {
		state.notice = message;
		window.clearTimeout(noticeTimer);
		noticeTimer = window.setTimeout(() => {
			state.notice = null;
			if (state.step === 'pick' && state.pickView === 'menu') renderPick();
		}, 2600);
	}

	const flowEl = document.querySelector<HTMLElement>('[data-flow]')!;
	let flowItems: HTMLElement[] = [];
	const deviceButtons = Array.from(
		document.querySelectorAll<HTMLElement>('[data-device]'),
	);

	/** Rebuild the step rail for the active device and re-bind its handlers. */
	function buildFlowRail(): void {
		const steps = activeSteps();
		flowEl.innerHTML = steps
			.map(
				(s, i) =>
					`<li class="flow-item" data-jump="${s}" role="tab" tabindex="0">
						<span class="flow-num">${String(i + 1).padStart(2, '0')}</span>
						<span class="flow-name">${s}</span>
					</li>`,
			)
			.join('');
		flowItems = Array.from(flowEl.querySelectorAll<HTMLElement>('.flow-item'));
		for (const el of flowItems) {
			el.addEventListener('click', () => {
				const step = el.dataset.jump;
				if (step && (activeSteps() as readonly string[]).includes(step)) {
					setStep(step as Step);
				}
			});
			el.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					el.click();
					e.preventDefault();
				}
			});
		}
	}
	const termTitle = document.querySelector<HTMLElement>('[data-term-title]')!;

	const esc = (s: string) =>
		s
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;');

	function setStep(next: Step): void {
		state.step = next;
		if (next === 'pick') {
			// Always land in the stage menu, with cursor restored.
			state.pickView = 'menu';
			state.currentStageId = null;
			state.cursor = state.menuCursor;
		} else {
			state.cursor = 0;
		}
		for (const s of ALL_STEPS) {
			screens[s].hidden = s !== next;
		}
		if (next === 'converge') startConverge();
		if (next === 'doctor') state.driftRepaired = false;
		updateTitle();
		refreshHints();
		for (const el of flowItems) {
			const is = el.dataset.jump === next;
			el.classList.toggle('active', is);
			el.setAttribute('aria-selected', is ? 'true' : 'false');
		}
		if (next === 'run') {
			++installRunId; // cancel any in-flight animation
			state.installPhase = 'prompt';
			state.installLog = [];
			state.installIndex = 0;
		}
		render();
		if (next === 'write') void runWriteAnimation();
	}

	function updateTitle(): void {
		const host = HOST_BY_DEVICE[state.device];
		let title = `${host} — ${TITLE_SUFFIX[state.step]}`;
		if (state.step === 'pick' && state.pickView === 'stage') {
			const stage = stages.find((s) => s.id === state.currentStageId);
			if (stage) title = `${host} — pick · ${stage.short.toLowerCase()}`;
		}
		if (state.step === 'wizard') {
			title = `${host} — run · ${QUESTIONS[state.questionIndex].title}`;
		}
		termTitle.textContent = title;
	}

	function render(): void {
		if (state.step === 'splash') renderSplash();
		if (state.step === 'pick') renderPick();
		if (state.step === 'review') renderReview();
		if (state.step === 'run') renderRun();
		if (state.step === 'wizard') renderWizard();
		if (state.step === 'manifest') renderManifest();
		if (state.step === 'converge') renderConverge();
		if (state.step === 'doctor') renderDoctor();
		renderHelpPanel();
		updateReadout();
	}

	function renderSplash(): void {
		if (state.flow === 'wizard') return renderSplashWizard();
		const spells = String(flat.length);
		const stagesN = String(stages.length);

		const boxBorder = (left: string, right: string): string =>
			`<span class="t-dim">${left}${'─'.repeat(22)}${right}</span>`;

		const boxRow = (label: string, value: string): string => {
			const pad = Math.max(1, 20 - label.length - value.length);
			const spaces = ' '.repeat(pad);
			return (
				`<span class="t-dim">│</span> ` +
				`<span class="t-muted">${label}</span>` +
				spaces +
				`<span class="t-accent">${value}</span>` +
				` <span class="t-dim">│</span>`
			);
		};

		// 5-space indent · 49-char MAGUS wordmark · 5-space gap · 24-char status box
		const indent = '     ';
		const gap = '     ';
		const wide = (logo: string, box: string): string =>
			`${indent}<span class="t-accent">${logo}</span>${gap}${box}`;

		const legend = stages
			.map(
				(s) =>
					`<span class="t-accent">${s.sigil}</span> <span class="t-muted">${esc(s.short.toLowerCase())}</span>`,
			)
			.join(`<span class="t-dim"> · </span>`);

		const lines: Array<{ html: string; tight?: boolean }> = [
			{ html: '' },
			{ html: wide('███╗   ███╗  █████╗   ██████╗  ██╗   ██╗ ███████╗', boxBorder('┌', '┐')), tight: true },
			{ html: wide('████╗ ████║ ██╔══██╗ ██╔════╝  ██║   ██║ ██╔════╝', boxRow('magus.sh', 'v0.1')), tight: true },
			{ html: wide('██╔████╔██║ ███████║ ██║  ███╗ ██║   ██║ ███████╗', boxRow('spells', spells)), tight: true },
			{ html: wide('██║╚██╔╝██║ ██╔══██║ ██║   ██║ ██║   ██║ ╚════██║', boxRow('stages', stagesN)), tight: true },
			{ html: wide('██║ ╚═╝ ██║ ██║  ██║ ╚██████╔╝ ╚██████╔╝ ███████║', boxRow('runtime', '~10 min')), tight: true },
			{ html: wide('╚═╝     ╚═╝ ╚═╝  ╚═╝  ╚═════╝   ╚═════╝  ╚══════╝', boxBorder('└', '┘')), tight: true },
			{ html: '' },
			{ html: `              <span class="t-muted">your device, transmuted in ten minutes</span>` },
			{ html: '' },
			{ html: `   <span class="t-dim">───</span>  ${legend}  <span class="t-dim">───</span>` },
			{ html: '' },
			{ html: `     <span class="t-accent">✓</span>  <span class="t-muted">repeatable — safe to run again</span>` },
			{ html: `     <span class="t-accent">✓</span>  <span class="t-muted">no telemetry · one script · paste, pick, run</span>` },
			{ html: '' },
			{ html: `     <span class="t-accent">›</span> <span class="t-muted">press</span> <span class="t-accent">[enter]</span> <span class="t-muted">to begin the ceremony</span> <span class="cursor-blink">▌</span>` },
		];

		const tightStyle =
			'white-space:pre;line-height:1;min-height:1em;display:block;padding:0 6px;margin:0 -6px';
		const looseStyle =
			'white-space:pre;line-height:1.6;min-height:1.6em;display:block;padding:0 6px;margin:0 -6px';

		screens.splash.innerHTML = lines
			.map(
				(l) =>
					`<div class="line${l.tight ? ' tight' : ''}" style="${l.tight ? tightStyle : looseStyle}">${l.html || '&nbsp;'}</div>`,
			)
			.join('');
	}

	// =========================================================================
	// Steam Machine path — wizard → manifest → converge → doctor
	// =========================================================================

