	/** Whether an option is currently chosen, for the question at `index`. */
	function isChosen(q: Question, optId: string): boolean {
		if (q.id === 'bundles') return state.manifest.bundles.has(optId);
		if (q.id === 'optimise') return state.manifest.optimise === (optId === 'yes');
		return (state.manifest as unknown as Record<string, string>)[q.id] === optId;
	}

	function renderWizard(): void {
		const q = QUESTIONS[state.questionIndex];
		const lines: string[] = [];
		lines.push(
			`<span class="t-dim">── </span><span class="t-muted">question ${state.questionIndex + 1} of ${QUESTIONS.length}</span>` +
				`<span class="t-dim"> ${'─'.repeat(Math.max(2, 34 - q.title.length))} </span><span class="t-bright">${esc(q.title)}</span>`,
		);
		lines.push('');
		lines.push(`  <span class="t-bright">${esc(q.prompt)}</span>`);
		lines.push('');

		q.options.forEach((opt, i) => {
			const focused = i === state.cursor;
			const chosen = isChosen(q, opt.id);
			const marker = q.multi
				? chosen
					? `<span class="t-accent">[×]</span>`
					: `<span class="t-dim">[ ]</span>`
				: chosen
					? `<span class="t-accent">●</span>`
					: `<span class="t-dim">○</span>`;
			const caret = focused
				? `<span class="t-accent">▸</span>`
				: `<span class="t-dim"> </span>`;
			const name = `<span class="${focused ? 't-bright' : chosen ? 't-text' : 't-muted'}">${esc(opt.name.padEnd(16))}</span>`;
			lines.push(`${caret} ${marker} ${name}<span class="t-muted">${esc(opt.note)}</span>`);
		});

		lines.push('');
		lines.push(`  <span class="t-dim">${'─'.repeat(56)}</span>`);
		if (q.id === 'optimise') {
			// Built today, on both devices.
			for (const o of [
				'Disable Baloo                 stops the indexer pinning the CPU',
				'Double-click to open          instead of KDE’s single click',
				state.device === 'machine'
					? 'Cursor size 48px              you’re three metres away'
					: 'Cursor size 32px              easier to track with thumbs',
				'Proton-GE                     more games run, fewer tweaks',
			]) {
				lines.push(`  <span class="t-accent">✓</span> <span class="t-muted">${esc(o)}</span>`);
			}
			// Recorded but not built, and only on a machine plugged into a TV.
			if (state.device === 'machine') {
				for (const o of [
					'HDMI colour range → full RGB  blacks are grey without it',
					'HDMI-CEC                      the TV wakes with the machine',
					'Performance power profile     it’s plugged into a wall',
				]) {
					lines.push(`  <span class="t-dim">· ${esc(o)}</span>`);
				}
				lines.push('');
				lines.push(`  <span class="t-dim">· not built yet — the manifest records your answer</span>`);
			}
		} else if (q.id === 'bundles') {
			const apps = [...state.manifest.bundles]
				.reduce((n, b) => n + (BUNDLE_APPS[b]?.length ?? 0), 0);
			lines.push(
				`  <span class="t-text">${apps} apps</span><span class="t-dim"> · </span>` +
					`<span class="t-text">~${(apps * 0.17).toFixed(1)} GB</span><span class="t-dim"> · </span>` +
					`<span class="t-muted">flatpak, sandboxed, removable</span>`,
			);
		} else {
			const chosenOpt = q.options.find((o) => isChosen(q, o.id));
			lines.push(`  <span class="t-muted">${esc(chosenOpt?.note ?? '')}</span>`);
			lines.push(
				`  <span class="t-accent">default</span><span class="t-dim"> · press enter to accept</span>`,
			);
		}
		screens.wizard.innerHTML = renderLines(lines);
	}

	/** The plan the manifest implies — mirrors StepsFor() in magus/steps.go. */
	function plannedSteps(): Array<{ id: string; label: string }> {
		const out: Array<{ id: string; label: string }> = [
			{ id: 'flathub', label: 'add the Flathub remote' },
		];
		out.push({
			id: `terminal:${state.manifest.terminal}`,
			label:
				state.manifest.terminal === 'konsole'
					? 'keep the stock Konsole'
					: `install ${state.manifest.terminal}`,
		});
		out.push({
			id: `browser:${state.manifest.browser}`,
			label: `install ${state.manifest.browser} as a user flatpak`,
		});
		for (const b of ['essentials', 'gaming', 'creative', 'dev', 'comms']) {
			if (!state.manifest.bundles.has(b)) continue;
			for (const app of BUNDLE_APPS[b]) {
				out.push({ id: `bundle:${b}/${app}`, label: `install ${app}` });
			}
		}
		if (state.manifest.optimise) {
			out.push({ id: 'optimise:double-click', label: 'double-click to open' });
			out.push({ id: 'optimise:baloo-off', label: 'disable the file indexer' });
			out.push({
				id: 'optimise:cursor-size',
				label: `cursor size ${state.device === 'machine' ? 48 : 32}px`,
			});
			out.push({ id: 'optimise:proton-ge', label: 'install the latest GE-Proton' });
			if (state.device === 'machine') {
				out.push({ id: 'optimise:hdmi-full-range', label: 'HDMI colour range → full RGB' });
				out.push({ id: 'optimise:cec', label: 'enable HDMI-CEC' });
				out.push({ id: 'optimise:power-profile', label: 'performance power profile' });
			}
		}
		out.push({ id: `theme:${state.manifest.theme}`, label: 'apply the global theme' });
		return out;
	}

	function manifestToml(): string[] {
		const bundles = [...state.manifest.bundles].map((b) => `"${b}"`).join(', ');
		return [
			'[magus]',
			'version = "0.3.0"',
			`device  = "${state.device === 'machine' ? 'steam-machine' : 'steam-deck'}"`,
			'',
			'[choices]',
			`terminal = "${state.manifest.terminal}"`,
			`browser  = "${state.manifest.browser}"`,
			`bundles  = [${bundles}]`,
			`theme    = "${state.manifest.theme}"`,
			'',
			'[optimisations]',
			`baloo_off       = ${state.manifest.optimise}`,
			`double_click    = ${state.manifest.optimise}`,
			`cursor_size     = ${state.manifest.optimise ? (state.device === 'machine' ? 48 : 32) : 0}`,
			`proton_ge       = ${state.manifest.optimise}`,
			`hdmi_full_range = ${state.manifest.optimise && state.device === 'machine'}`,
			`cec             = ${state.manifest.optimise && state.device === 'machine'}`,
			`power_profile   = "${state.manifest.optimise && state.device === 'machine' ? 'performance' : 'balanced'}"`,
		];
	}

	function renderManifest(): void {
		const lines: string[] = [];
		lines.push(
			`<span class="t-dim">── </span><span class="t-muted">review</span><span class="t-dim"> ${'─'.repeat(46)}</span>`,
		);
		lines.push('');
		const rows: Array<[string, string]> = [
			['terminal', state.manifest.terminal],
			['browser', state.manifest.browser],
			['bundles', [...state.manifest.bundles].join(', ') || 'none'],
			['theme', state.manifest.theme],
			['optimise', state.manifest.optimise ? '5 applied' : 'skipped'],
		];
		for (const [k, v] of rows) {
			lines.push(`  <span class="t-muted">${k.padEnd(11)}</span><span class="t-text">${esc(v)}</span>`);
		}
		lines.push('');
		lines.push(
			`  <span class="t-muted">This writes one file — </span><span class="t-text">~/.config/magus/manifest.toml</span>`,
		);
		lines.push('');
		for (const l of manifestToml()) {
			lines.push(`    <span class="t-dim">${esc(l)}</span>`);
		}
		lines.push('');
		lines.push(
			`  <span class="t-muted">Everything after this reads only that file. Edit it later</span>`,
		);
		lines.push(
			`  <span class="t-muted">and run </span><span class="t-text">magus reconcile</span><span class="t-muted"> to converge — ${plannedSteps().length} steps.</span>`,
		);
		screens.manifest.innerHTML = renderLines(lines);
	}

	function startConverge(): void {
		++state.convergeRunId;
		const runId = state.convergeRunId;
		state.convergeIndex = 0;
		state.convergePhase = 'running';
		const total = plannedSteps().length;
		const tick = (): void => {
			if (runId !== state.convergeRunId || state.step !== 'converge') return;
			state.convergeIndex += 1;
			if (state.convergeIndex >= total) {
				state.convergeIndex = total;
				state.convergePhase = 'done';
				refreshHints();
				renderConverge();
				return;
			}
			renderConverge();
			window.setTimeout(tick, 340);
		};
		window.setTimeout(tick, 420);
	}

	function renderConverge(): void {
		const steps = plannedSteps();
		const done = state.convergeIndex;
		const total = steps.length;
		const lines: string[] = [];

		if (state.convergePhase === 'done') {
			lines.push(`<span class="t-bright">── summary</span>`);
			lines.push(
				`  <span class="t-accent">✓</span> <span class="t-text">${total} changed · 0 already correct · 0 not applicable</span>`,
			);
			lines.push('');
			lines.push(`  <span class="t-bright">your machine is set up.</span>`);
			lines.push('');
			lines.push(
				`  <span class="t-muted">Run </span><span class="t-text">magus doctor</span><span class="t-muted"> any time to check nothing has broken.</span>`,
			);
			lines.push(
				`  <span class="t-muted">When SteamOS updates and something disappears,</span>`,
			);
			lines.push(
				`  <span class="t-text">magus reconcile</span><span class="t-muted"> puts it back. No decisions required.</span>`,
			);
			lines.push('');
			lines.push(
				`  <span class="t-dim">press </span><span class="t-accent">[→]</span><span class="t-dim"> to jump forward two months</span>`,
			);
			screens.converge.innerHTML = renderLines(lines);
			return;
		}

		const pct = Math.round((done / total) * 100);
		const barLen = 28;
		const bar =
			'█'.repeat(Math.round((pct / 100) * barLen)) +
			'░'.repeat(barLen - Math.round((pct / 100) * barLen));
		lines.push(
			`<span class="t-bright">converging ${done}/${total}  </span>` +
				`<span class="t-dim">[</span><span class="t-accent">${bar}</span><span class="t-dim">]  ${pct}%</span>`,
		);
		lines.push('');
		for (const s of steps.slice(Math.max(0, done - 4), done)) {
			lines.push(
				`  <span class="t-accent">✓</span> <span class="t-muted">${esc(s.id)}</span>`,
			);
		}
		if (done < total) {
			lines.push(
				`  <span class="t-accent">›</span> <span class="t-bright">${esc(steps[done].id)}</span>` +
					`<span class="cursor-blink">▌</span>`,
			);
			lines.push(`    <span class="t-dim">${esc(steps[done].label)}</span>`);
		}
		screens.converge.innerHTML = renderLines(lines);
	}

	/** Two steps are broken by the simulated atomic update. */
	const DRIFTED = ['terminal:kitty', 'theme'];

	function renderDoctor(): void {
		const steps = plannedSteps();
		const lines: string[] = [];
		const drifted = state.driftRepaired
			? []
			: steps.filter((s) => DRIFTED.some((d) => s.id.startsWith(d)));

		lines.push(
			`<span class="t-dim">$ </span><span class="t-text">magus doctor</span>` +
				`<span class="t-dim">   # two months later, after an OS update</span>`,
		);
		lines.push('');
		lines.push(`<span class="t-bright">── device</span>`);
		lines.push(
			`  <span class="t-accent">✓</span> <span class="t-text">steam-machine</span> <span class="t-dim">— heuristic, unverified</span>`,
		);
		lines.push('');
		lines.push(`<span class="t-bright">── steps</span>`);
		for (const s of steps.slice(0, 8)) {
			const bad = drifted.some((d) => d.id === s.id);
			lines.push(
				bad
					? `  <span class="t-warn">!</span> <span class="t-text">${esc(s.id.padEnd(30))}</span><span class="t-warn">drifted</span>`
					: `  <span class="t-accent">✓</span> <span class="t-muted">${esc(s.id.padEnd(30))}</span><span class="t-dim">ok</span>`,
			);
		}
		lines.push('');
		lines.push(`<span class="t-bright">── summary</span>`);
		if (drifted.length === 0) {
			lines.push(
				`  <span class="t-accent">✓</span> <span class="t-text">no drift — ${steps.length} steps all correct</span>`,
			);
			lines.push('');
			lines.push(
				`  <span class="t-dim">exit 0. Nothing to do — this is the normal case.</span>`,
			);
		} else {
			lines.push(
				`  <span class="t-warn">!</span> <span class="t-text">${drifted.length} of ${steps.length} steps need attention</span>`,
			);
			lines.push(`  <span class="t-dim">exit 1</span>`);
			lines.push('');
			lines.push(
				`  <span class="t-bright">press </span><span class="t-accent">[y]</span>` +
					`<span class="t-bright"> to run </span><span class="t-text">magus reconcile</span>` +
					`<span class="t-bright"> and repair</span><span class="cursor-blink">▌</span>`,
			);
		}
		screens.doctor.innerHTML = renderLines(lines);
	}

	type MenuRow =
		| { kind: 'stage'; stage: Stage }
		| { kind: 'preset'; preset: Preset }
		| { kind: 'action'; id: 'review' | 'write' | 'quit'; label: string };

	type StageRow =
		| { kind: 'item'; cmd: Cmd }
		| { kind: 'group'; group: AppGroup }
		| { kind: 'select-all' }
		| { kind: 'install' }
		| { kind: 'back-group' }
		| { kind: 'back' };

	function menuRows(): MenuRow[] {
		const rows: MenuRow[] = stages.map((s) => ({ kind: 'stage', stage: s }));
		for (const p of PRESETS) rows.push({ kind: 'preset', preset: p });
		rows.push({ kind: 'action', id: 'review', label: 'Review my picks' });
		rows.push({ kind: 'action', id: 'quit', label: 'Quit' });
		return rows;
	}

	function stageRowsFor(stage: Stage): StageRow[] {
		const groups = STAGE_GROUPS[stage.id];

		if (groups && !state.currentGroupId) {
			// Show group list
			const rows: StageRow[] = groups.map((g) => ({ kind: 'group', group: g }));
			rows.push({ kind: 'install' });
			rows.push({ kind: 'back' });
			return rows;
		}

		// Show items — filtered to current group if one is open
		let items = stage.items;
		if (state.currentGroupId && groups) {
			const group = groups.find((g) => g.id === state.currentGroupId);
			if (group) {
				items = stage.items.filter((cmd) =>
					group.patterns.some((p) => matchPattern(cmd.id, p)),
				);
			}
		}
		const rows: StageRow[] = items.map((cmd) => ({ kind: 'item', cmd }));
		rows.push({ kind: 'select-all' });
		if (state.currentGroupId) {
			rows.push({ kind: 'back-group' });
		} else {
			rows.push({ kind: 'install' });
			rows.push({ kind: 'back' });
		}
		return rows;
	}

	function rowCount(): number {
		if (state.step !== 'pick') return 0;
		if (state.pickView === 'menu') return menuRows().length;
		const stage = stages.find((s) => s.id === state.currentStageId);
		return stage ? stageRowsFor(stage).length : 0;
	}

	function presetMatches(preset: Preset): Cmd[] {
		const seen = new Set<string>();
		const out: Cmd[] = [];
		for (const p of preset.patterns) {
			for (const f of flat) {
				if (matchPattern(f.cmd.id, p) && !seen.has(f.cmd.id)) {
					seen.add(f.cmd.id);
					out.push(f.cmd);
				}
			}
		}
		return out;
	}

	function previewBlock(title: string, lines: string[]): Array<{ html: string }> {
		const out: Array<{ html: string }> = [];
		out.push({
			html: `<span class="t-dim">── ${esc(title)} ${'─'.repeat(Math.max(2, 28 - title.length))}</span>`,
		});
		out.push({ html: '' });
		for (const l of lines) out.push({ html: l });
		return out;
	}

	function previewForMenuRow(row: MenuRow): Array<{ html: string }> {
		if (row.kind === 'stage') {
			const stage = row.stage;
			const total = stage.items.length;
			const picked = stage.items.filter((c) => state.picked.has(c.id)).length;
			const groups = STAGE_GROUPS[stage.id];
			const lines: string[] = [];
			lines.push(
				`<span class="t-accent">${stage.sigil}</span>  <span class="t-bright">${stage.num} ${esc(stage.short)}</span>`,
			);
			lines.push(`<span class="t-muted">${esc(stage.tagline)}</span>`);
			lines.push('');
			if (groups) {
				lines.push(`<span class="t-dim">includes</span>`);
				for (const g of groups) {
					const gItems = stage.items.filter((c) =>
						g.patterns.some((p) => matchPattern(c.id, p)),
					);
					const gPicked = gItems.filter((c) => state.picked.has(c.id)).length;
					const count =
						gPicked > 0
							? `<span class="t-accent">${gPicked}/${gItems.length}</span>`
							: `<span class="t-dim">${gItems.length}</span>`;
					lines.push(
						`  <span class="t-text">${esc(g.name)}</span>  ${count}`,
					);
				}
			} else {
				lines.push(`<span class="t-dim">commands</span>`);
				for (const c of stage.items.slice(0, 8)) {
					const isPicked = state.picked.has(c.id);
					const mark = isPicked
						? `<span class="t-accent">◉</span>`
						: `<span class="t-dim">◯</span>`;
					lines.push(`  ${mark} <span class="t-muted">${esc(c.title)}</span>`);
				}
				if (stage.items.length > 8) {
					lines.push(
						`  <span class="t-dim">… +${stage.items.length - 8} more</span>`,
					);
				}
			}
			lines.push('');
			lines.push(
				`<span class="t-dim">${picked}/${total} picked · ~${Math.max(2, Math.round(total * 1.4))} min if all</span>`,
			);
			return previewBlock('stage', lines);
		}
		if (row.kind === 'preset') {
			const matched = presetMatches(row.preset);
			const lines: string[] = [];
			lines.push(
				`<span class="t-accent">✦</span>  <span class="t-bright">${esc(row.preset.name)}</span>`,
			);
			lines.push(`<span class="t-muted">${esc(row.preset.tagline)}</span>`);
			lines.push('');
			lines.push(
				`<span class="t-dim">applies ${matched.length} commands</span>`,
			);
			for (const c of matched.slice(0, 12)) {
				lines.push(`  <span class="t-accent">+</span> <span class="t-muted">${esc(c.title)}</span>`);
			}
			if (matched.length > 12) {
				lines.push(
					`  <span class="t-dim">… +${matched.length - 12} more</span>`,
				);
			}
			lines.push('');
			lines.push(`<span class="t-dim">enter to apply · won't deselect anything</span>`);
			return previewBlock('preset', lines);
		}
		// action row
		if (row.id === 'review') {
			const lines: string[] = [];
			lines.push(`<span class="t-bright">Review my picks</span>`);
			lines.push(
				`<span class="t-muted">cross-stage summary, then write a script.</span>`,
			);
			lines.push('');
			lines.push(
				`<span class="t-dim">${state.picked.size} commands queued so far</span>`,
			);
			return previewBlock('review', lines);
		}
		const quitLines = [
			`<span class="t-bright">Quit</span>`,
			`<span class="t-muted">clears picks and returns to splash.</span>`,
		];
		return previewBlock('quit', quitLines);
	}

	function previewForStageRow(
		row: StageRow,
		stage: Stage,
	): Array<{ html: string }> {
		if (row.kind === 'item') {
			const lines: string[] = [];
			const isPicked = state.picked.has(row.cmd.id);
			const box = isPicked
				? `<span class="t-accent">◉</span>`
				: `<span class="t-dim">◯</span>`;
			lines.push(`${box}  <span class="t-bright">${esc(row.cmd.title)}</span>`);
			if (row.cmd.summary) {
				lines.push(`<span class="t-muted">${esc(row.cmd.summary)}</span>`);
			}
			lines.push('');
			const runs = row.cmd.commands.slice(0, 3);
			if (runs.length > 0) {
				lines.push(`<span class="t-dim">will run</span>`);
				for (const c of runs) {
					lines.push(`  <span class="t-accent">$</span> <span class="t-text">${esc(c.run)}</span>`);
				}
				if (row.cmd.commands.length > runs.length) {
					lines.push(
						`  <span class="t-dim">… +${row.cmd.commands.length - runs.length} more</span>`,
					);
				}
			}
			lines.push('');
			lines.push(
				`<span class="t-dim">space toggles · enter also toggles</span>`,
			);
			return previewBlock(stage.short.toLowerCase(), lines);
		}
		if (row.kind === 'group') {
			const items = stage.items.filter((c) =>
				row.group.patterns.some((p) => matchPattern(c.id, p)),
			);
			const picked = items.filter((c) => state.picked.has(c.id)).length;
			const lines: string[] = [];
			lines.push(`<span class="t-bright">${esc(row.group.name)}</span>`);
			lines.push(
				`<span class="t-muted">${items.length} commands · ${picked} picked</span>`,
			);
			lines.push('');
			for (const c of items.slice(0, 10)) {
				const isPicked = state.picked.has(c.id);
				const mark = isPicked
					? `<span class="t-accent">◉</span>`
					: `<span class="t-dim">◯</span>`;
				lines.push(`  ${mark} <span class="t-muted">${esc(c.title)}</span>`);
			}
			if (items.length > 10) {
				lines.push(`  <span class="t-dim">… +${items.length - 10} more</span>`);
			}
			return previewBlock('group', lines);
		}
		if (row.kind === 'install') {
			const stagePicked = stage.items.filter((c) => state.picked.has(c.id));
			const lines: string[] = [];
			if (stagePicked.length === 0) {
				lines.push(`<span class="t-warn">nothing picked yet</span>`);
				lines.push(
					`<span class="t-muted">space toggles a command. enter on a row also works.</span>`,
				);
			} else {
				lines.push(
					`<span class="t-accent">⚡</span>  <span class="t-bright">${stagePicked.length} command${stagePicked.length === 1 ? '' : 's'} ready</span>`,
				);
				lines.push(
					`<span class="t-muted">est. ~${Math.max(1, Math.round(stagePicked.length * 0.8))} min · ${stage.short.toLowerCase()} stage only</span>`,
				);
				lines.push('');
				for (const c of stagePicked.slice(0, 10)) {
					lines.push(`  <span class="t-accent">✓</span> <span class="t-muted">${esc(c.title)}</span>`);
				}
				if (stagePicked.length > 10) {
					lines.push(
						`  <span class="t-dim">… +${stagePicked.length - 10} more</span>`,
					);
				}
			}
			return previewBlock('install', lines);
		}
		if (row.kind === 'select-all') {
			const allSelected = stage.items.every((c) => state.picked.has(c.id));
			const lines = [
				`<span class="t-bright">${allSelected ? 'Deselect all in this stage' : 'Select all in this stage'}</span>`,
				`<span class="t-muted">toggles every command in ${esc(stage.short)} (${stage.items.length} total).</span>`,
			];
			return previewBlock('shortcut', lines);
		}
		if (row.kind === 'back-group') {
			return previewBlock('back', [
				`<span class="t-bright">← back to ${esc(stage.short)}</span>`,
				`<span class="t-muted">return to the group list. picks stay.</span>`,
			]);
		}
		return previewBlock('back', [
			`<span class="t-bright">← back to stages</span>`,
			`<span class="t-muted">return to the stage menu. picks carry across.</span>`,
		]);
	}

	function paintLines(
		target: HTMLElement,
		lines: Array<{ html: string; focused?: boolean }>,
		preview?: Array<{ html: string }>,
	): void {
		const leftHtml = lines
			.map(
				(l) =>
					`<div class="line${l.focused ? ' is-focused' : ''}">${l.html || '&nbsp;'}</div>`,
			)
			.join('');
		if (preview && preview.length > 0) {
			const rightHtml = preview
				.map(
					(l) =>
						`<div class="line">${l.html || '&nbsp;'}</div>`,
				)
				.join('');
			target.innerHTML =
				`<div class="split">` +
				`<div class="split-left">${leftHtml}</div>` +
				`<div class="split-right">${rightHtml}</div>` +
				`</div>`;
		} else {
			target.innerHTML = leftHtml;
		}
		const focusedEl = target.querySelector<HTMLElement>('.is-focused');
		if (focusedEl) {
			focusedEl.scrollIntoView({ block: 'nearest', behavior: 'auto' });
		}
	}

	function renderPick(): void {
		if (state.pickView === 'search') renderSearch();
		else if (state.pickView === 'menu') renderMenu();
		else if (state.pickView === 'installing') renderStageInstall();
		else renderStage();
		renderHelpPanel();
		updateReadout();
	}

	function renderStageInstall(): void {
		const stage = stages.find((s) => s.id === state.currentStageId);
		const stagePicks = stage
			? flat.filter((f) => f.stage.id === stage.id && state.picked.has(f.cmd.id))
			: [];
		const total = stagePicks.length;
		const done = state.installLog.length;
		const lines: string[] = [];

		if (state.installPhase === 'done') {
			const succeeded = state.installLog.filter((e) => e.result === 'done').length;
			const skipped = state.installLog.filter((e) => e.result === 'skipped').length;
			lines.push(`<span class="t-accent">${esc(stage?.short ?? 'stage')} done ✓</span>`);
			lines.push('');
			lines.push(`  <span class="t-accent">${succeeded}</span> <span class="t-text">installed</span>${skipped > 0 ? `   <span class="t-dim">${skipped} skipped</span>` : ''}`);
			lines.push('');
			for (const entry of state.installLog) {
				const icon = entry.result === 'done'
					? `<span class="t-accent">✓</span>`
					: `<span class="t-dim">—</span>`;
				const title = entry.result === 'skipped'
					? `<span class="t-dim">${esc(entry.title)}</span>`
					: `<span class="t-muted">${esc(entry.title)}</span>`;
				lines.push(`  ${icon} ${title}`);
			}
			lines.push('');
			lines.push(`<span class="t-dim">press [esc] to continue to next stage</span>`);
			screens.pick.innerHTML = renderLines(lines);
			return;
		}

		const current = stagePicks[state.installLog.length];
		screens.pick.innerHTML = progressPanel({
			title: `${stage?.short ?? 'stage'} install`,
			done,
			total,
			current,
			log: state.installLog,
			failed: state.installPhase === 'failed',
		});
	}

	function updateSearch(query: string): void {
		state.searchQuery = query;
		const q = query.toLowerCase();
		state.searchResults = flat.filter(
			(f) =>
				f.cmd.title.toLowerCase().includes(q) ||
				f.cmd.summary.toLowerCase().includes(q),
		);
		state.cursor = 0;
		renderSearch();
	}

	function renderSearch(): void {
		const out: Array<{ html: string; focused?: boolean }> = [];
		const query = state.searchQuery;

		out.push({
			html: `<span class="t-accent">/</span> <span class="t-bright">Search all spells</span>`,
		});
		out.push({
			html: `<span class="t-dim">  ▌</span><span class="t-muted">${esc(query)}</span>`,
		});
		out.push({ html: '' });

		if (state.searchResults.length === 0) {
			out.push({
				html: `<span class="t-muted">  no spells match "${esc(query)}"</span>`,
			});
		} else {
			// Show up to 12 results
			const shown = state.searchResults.slice(0, 12);
			shown.forEach((f, i) => {
				const focused = i === state.cursor;
				const cur = focused ? `<span class="t-accent">❯</span>` : ` `;
				const picked = state.picked.has(f.cmd.id);
				const box = picked
					? `<span class="t-accent">◉</span>`
					: `<span class="t-dim">◯</span>`;
				const name = focused
					? `<span class="t-bright">${esc(f.cmd.title).padEnd(30)}</span>`
					: picked
						? `<span class="t-text">${esc(f.cmd.title).padEnd(30)}</span>`
						: `<span class="t-muted">${esc(f.cmd.title).padEnd(30)}</span>`;
				const stage = `<span class="t-dim">${f.stage.num}</span>`;
				out.push({ html: `${cur} ${box} ${name}${stage}`, focused });
			});
			if (state.searchResults.length > shown.length) {
				out.push({
					html: `<span class="t-dim">  … +${state.searchResults.length - shown.length} more</span>`,
				});
			}
		}

		out.push({ html: '' });
		out.push({
			html: `<span class="t-dim">↑↓ move · space toggle · esc back</span>`,
		});

		paintLines(screens.pick, out);
	}

	function renderMenu(): void {
		const rows = menuRows();
		const out: Array<{ html: string; focused?: boolean }> = [];

		out.push({
			html: `<span class="t-accent">?</span> <span class="t-bright">Where to next?</span> <span class="t-muted">(↑ ↓ move · enter open)</span>`,
		});
		if (state.notice) {
			out.push({
				html: `<span class="t-band">${esc(state.notice)}</span>`,
			});
		}
		out.push({ html: '' });

		rows.forEach((row, i) => {
			const focused = i === state.cursor;
			const cur = focused ? `<span class="t-accent">❯</span>` : ` `;
			// separator before preset block
			if (row.kind === 'preset' && rows[i - 1]?.kind !== 'preset') {
				out.push({ html: `<span class="t-dim">  ────</span>` });
			}
			// separator before action block
			if (row.kind === 'action' && rows[i - 1]?.kind !== 'action') {
				out.push({ html: `<span class="t-dim">  ────</span>` });
			}
			if (row.kind === 'stage') {
				const total = row.stage.items.length;
				const picked = row.stage.items.filter((c) =>
					state.picked.has(c.id),
				).length;
				const sigilHtml = focused
					? `<span class="t-accent">${row.stage.sigil}</span>`
					: `<span class="t-dim">${row.stage.sigil}</span>`;
				const labelText = `${row.stage.num}  ${row.stage.short}`;
				const labelPadded =
					labelText + ' '.repeat(Math.max(2, 20 - labelText.length));
				const labelHtml = focused
					? `<span class="t-bright">${labelPadded}</span>`
					: `<span class="t-text">${labelPadded}</span>`;
				const countText = `${picked}/${total}`;
				const countHtml =
					picked > 0
						? `<span class="t-accent">${countText}</span>`
						: `<span class="t-dim">${countText}</span>`;
				const installed = state.installedStageIds.has(row.stage.id);
				const tick = installed
					? ` <span class="t-accent">⚡</span>`
					: picked === total && total > 0
						? ` <span class="t-accent">✓</span>`
						: ``;
				out.push({
					html: `${cur} ${sigilHtml}  ${labelHtml}${countHtml}${tick}`,
					focused,
				});
			} else if (row.kind === 'preset') {
				const matchCount = presetMatches(row.preset).length;
				const nameHtml = focused
					? `<span class="t-accent">✦</span> <span class="t-bright">${esc(row.preset.name)}</span>`
					: `<span class="t-dim">✦</span> <span class="t-muted">${esc(row.preset.name)}</span>`;
				const tagHtml = focused
					? `<span class="t-muted"> · ${esc(row.preset.tagline)}</span>`
					: `<span class="t-dim"> · ${esc(row.preset.tagline)}</span>`;
				const countHtml = `<span class="t-dim">  ${matchCount}</span>`;
				out.push({ html: `${cur}  ${nameHtml}${tagHtml}${countHtml}`, focused });
			} else {
				const reviewN = state.picked.size;
				const label =
					row.id === 'review' ? `Review my picks (${reviewN})` : row.label;
				const labelHtml = focused
					? `<span class="t-bright">${label}</span>`
					: `<span class="t-muted">${label}</span>`;
				out.push({ html: `${cur}  ${labelHtml}`, focused });
			}
		});

		out.push({ html: '' });
		out.push({
			html: `<span class="t-dim">${state.picked.size} of ${flat.length} commands selected total</span>`,
		});

		const focusedRow = rows[state.cursor];
		const preview = focusedRow ? previewForMenuRow(focusedRow) : undefined;
		paintLines(screens.pick, out, preview);
	}

	function renderStage(): void {
		const stage = stages.find((s) => s.id === state.currentStageId);
		if (!stage) {
			state.pickView = 'menu';
			renderMenu();
			return;
		}

		const rows = stageRowsFor(stage);
		const out: Array<{ html: string; focused?: boolean }> = [];

		const groupLabel = state.currentGroupId
			? STAGE_GROUPS[stage.id]?.find((g) => g.id === state.currentGroupId)?.name ?? ''
			: '';
		const heading = groupLabel
			? `${stage.num} · ${esc(stage.short)} <span class="t-dim">›</span> ${esc(groupLabel)}`
			: `${stage.num} · ${esc(stage.short)}`;
		out.push({
			html: `<span class="t-accent">?</span> <span class="t-bright">${heading}</span> <span class="t-muted">(space toggle · enter open)</span>`,
		});
		const stageGroups = STAGE_GROUPS[stage.id];
		if (state.currentGroupId && stageGroups) {
			const tabs = stageGroups
				.map((g) => {
					const isCurrent = g.id === state.currentGroupId;
					return isCurrent
						? `<span class="t-accent">[${esc(g.name)}]</span>`
						: `<span class="t-dim">${esc(g.name)}</span>`;
				})
				.join(`<span class="t-dim">  </span>`);
			out.push({ html: `  ${tabs}` });
		}
		out.push({ html: '' });

		rows.forEach((row, i) => {
			const focused = i === state.cursor;
			const cur = focused ? `<span class="t-accent">❯</span>` : ` `;
			if (row.kind === 'item') {
				const picked = state.picked.has(row.cmd.id);
				const box = picked
					? `<span class="t-accent">◉</span>`
					: `<span class="t-dim">◯</span>`;
				const name = focused
					? `<span class="t-bright">${esc(row.cmd.title)}</span>`
					: picked
						? `<span class="t-text">${esc(row.cmd.title)}</span>`
						: `<span class="t-muted">${esc(row.cmd.title)}</span>`;
				out.push({ html: `${cur} ${box} ${name}`, focused });
			} else if (row.kind === 'select-all') {
				out.push({ html: `<span class="t-dim">  ────</span>` });
				const selectText = focused
					? `<span class="t-bright">select all in this stage</span>`
					: `<span class="t-muted">select all in this stage</span>`;
				out.push({ html: `${cur}   ${selectText}`, focused });
			} else if (row.kind === 'group') {
				const groupItems = stage.items.filter((cmd) =>
					row.group.patterns.some((p) => matchPattern(cmd.id, p)),
				);
				const groupPicked = groupItems.filter((c) => state.picked.has(c.id)).length;
				const labelText = esc(row.group.name);
				const padding = ' '.repeat(Math.max(2, 24 - row.group.name.length));
				const labelHtml = focused
					? `<span class="t-bright">${labelText}</span>${padding}`
					: `<span class="t-text">${labelText}</span>${padding}`;
				const countHtml = groupPicked > 0
					? `<span class="t-accent">${groupPicked}/${groupItems.length}</span>`
					: `<span class="t-dim">${groupPicked}/${groupItems.length}</span>`;
				const arrow = focused
					? ` <span class="t-accent">›</span>`
					: ` <span class="t-dim">›</span>`;
				out.push({ html: `${cur}  ${labelHtml}${countHtml}${arrow}`, focused });
			} else if (row.kind === 'install') {
				out.push({ html: `<span class="t-dim">  ────</span>` });
				const stagePicked = stage.items.filter((c) => state.picked.has(c.id)).length;
				const hasItems = stagePicked > 0;
				const noun = stagePicked === 1 ? 'command' : 'commands';
				const installHtml = focused && hasItems
					? `<span class="t-accent">⚡</span> <span class="t-bright">Install ${stagePicked} ${noun}</span>`
					: hasItems
						? `<span class="t-dim">⚡</span> <span class="t-muted">Install ${stagePicked} ${noun}</span>`
						: `<span class="t-dim">⚡ pick at least one to install</span>`;
				out.push({ html: `${cur}   ${installHtml}`, focused: focused && hasItems });
			} else if (row.kind === 'back-group') {
				out.push({ html: `<span class="t-dim">  ────</span>` });
				const back = focused
					? `<span class="t-bright">← back to ${esc(stage.short)}</span>`
					: `<span class="t-muted">← back to ${esc(stage.short)}</span>`;
				out.push({ html: `${cur}   ${back}`, focused });
			} else {
				out.push({ html: `<span class="t-dim">  ────</span>` });
				const back = focused
					? `<span class="t-bright">← back to stages</span>`
					: `<span class="t-muted">← back to stages</span>`;
				out.push({ html: `${cur}   ${back}`, focused });
			}
		});

		const stagePicked = stage.items.filter((c) => state.picked.has(c.id)).length;
		out.push({ html: '' });
		out.push({
			html: `<span class="t-dim">${stagePicked} of ${stage.items.length} selected in this stage</span>`,
		});

		const focusedRow = rows[state.cursor];
		const preview = focusedRow ? previewForStageRow(focusedRow, stage) : undefined;
		paintLines(screens.pick, out, preview);
	}

	function renderReview(): void {
		const lines: string[] = [];
		const picked = flat.filter((f) => state.picked.has(f.cmd.id));

		if (picked.length === 0) {
			lines.push(`<span class="t-warn">nothing picked.</span>`);
			lines.push('');
			lines.push(
				`<span class="t-muted">press</span> <span class="t-accent">[←]</span> <span class="t-muted">to go back, or</span> <span class="t-accent">[r]</span> <span class="t-muted">to restart.</span>`,
			);
			screens.review.innerHTML = renderLines(lines);
			return;
		}

		const mins = Math.max(2, Math.round(picked.length * 1.4));
		const deckOnly = picked.filter((f) => f.cmd.deckOnly).length;
		const elevated = picked.filter((f) => f.cmd.danger !== 'low').length;
		const focusIndex = Math.max(
			0,
			picked.findIndex((f) => f.cmd.danger !== 'low' || f.cmd.deckOnly),
		);
		lines.push(
			`<span class="t-bright">Review table</span> <span class="t-muted">· bubbles/table mock · ${picked.length} rows · est. ~${mins} min</span>`,
		);
		lines.push(
			`<span class="t-dim">risk</span> <span class="t-text">${elevated}</span> <span class="t-dim">elevated</span>   <span class="t-dim">deck-only</span> <span class="t-text">${deckOnly}</span>   <span class="t-dim">script</span> <span class="t-text">/tmp/magus.sh</span>`,
		);
		lines.push('');
		const tableRows = picked
			.map((f, i) => {
				const isFocused = i === focusIndex;
				const marker = isFocused
					? `<span class="t-accent">❯</span>`
					: `<span class="t-dim"> </span>`;
				const stage = `<span class="t-dim">${esc(f.stage.num)}</span> <span class="t-muted">${esc(clipText(f.stage.short, 9))}</span>`;
				const title = `<span class="${isFocused ? 't-bright' : 't-text'}">${esc(clipText(f.cmd.title, 28))}</span>`;
				const risk = `<span class="${riskClass(f.cmd)}">${riskLabel(f.cmd)}</span>`;
				const deck = f.cmd.deckOnly
					? `<span class="t-accent">deck</span>`
					: `<span class="t-dim">any</span>`;
				const eta = `<span class="t-dim">${commandEta(f.cmd)}</span>`;
				return `<div class="review-row${isFocused ? ' is-focused' : ''}">
					<span>${marker}</span>
					<span>${stage}</span>
					<span>${title}</span>
					<span>${risk}</span>
					<span>${deck}</span>
					<span>${eta}</span>
				</div>`;
			})
			.join('');
		const table =
			`<div class="review-table">
				<div class="review-row review-head">
					<span></span>
					<span>stage</span>
					<span>command</span>
					<span>risk</span>
					<span>device</span>
					<span>est</span>
				</div>
				${tableRows}
			</div>`;
		lines.push(
			`  <span class="t-accent">[y]</span> <span class="t-text">write to disk</span>     <span class="t-accent">[e]</span> <span class="t-muted">edit picks</span>     <span class="t-accent">[q]</span> <span class="t-muted">quit</span>`,
		);

		screens.review.innerHTML = renderLines(lines.slice(0, 3)) + table + renderLines(lines.slice(3));
	}

	let writeRunId = 0;
	function tintShellLine(line: string): string {
		const safe = esc(line);
		if (!line) return '&nbsp;';
		if (line.startsWith('#!')) return `<span class="t-muted">${safe}</span>`;
		if (line.startsWith('#')) return `<span class="t-dim">${safe}</span>`;
		if (line.startsWith('set ')) {
			return safe.replace('set', '<span class="t-accent">set</span>');
		}
		if (line.startsWith('echo ')) {
			return safe.replace('echo', '<span class="t-accent">echo</span>');
		}
		return `<span class="t-text">${safe}</span>`;
	}

	function scriptLinesFor(picked: Array<{ stage: Stage; cmd: Cmd }>, visibleCommands: number): string[] {
		const lines = [
			'#!/usr/bin/env bash',
			'set -euo pipefail',
			'',
			`# magus.sh — ${picked.length} selected commands`,
			'',
		];
		for (const f of picked.slice(0, visibleCommands)) {
			lines.push(`# ${f.stage.short}: ${f.cmd.title}`);
			const first = f.cmd.commands[0];
			lines.push(first ? first.run : `echo "skip ${f.cmd.title}"`);
			lines.push('');
		}
		return lines;
	}

	async function runWriteAnimation(): Promise<void> {
		const myRun = ++writeRunId;
		const target = screens.write;

		const picked = flat.filter((f) => state.picked.has(f.cmd.id));
		const sizeKb = Math.max(0.4, picked.length * 0.18).toFixed(1);

		const renderFrame = (visibleCommands: number, done = false): void => {
			const code = scriptLinesFor(picked, visibleCommands);
			const codeHtml = code
				.map(
					(line, i) =>
						`<div class="script-line"><span class="script-gutter">${String(i + 1).padStart(2, '0')}</span><span>${tintShellLine(line)}</span></div>`,
				)
				.join('');
			const more = picked.length > visibleCommands
				? `<div class="script-more">… ${picked.length - visibleCommands} commands waiting to be rendered</div>`
				: '';
			const status = done
				? `<span class="t-accent">saved</span> <span class="t-dim">/tmp/magus.sh · chmod +x · ${sizeKb} KB</span>`
				: `<span class="t-accent">writing</span> <span class="t-dim">/tmp/magus.sh · streaming selected commands</span> <span class="cursor-blink">▌</span>`;
			target.innerHTML =
				renderLines([
					`<span class="t-bright">Assembling magus.sh</span>`,
					status,
					'',
				]) +
				`<div class="script-box">${codeHtml}${more}</div>` +
				renderLines([
					'',
					done
						? `  <span class="t-accent">›</span> <span class="t-muted">press</span> <span class="t-accent">[enter]</span> <span class="t-muted">to continue</span> <span class="cursor-blink">▌</span>`
						: `<span class="t-dim">reviewing order, comments, and executable permissions</span>`,
				]);
		};

		const steps = Math.max(1, Math.min(picked.length, 6));
		target.innerHTML = '';
		for (let visible = 1; visible <= steps; visible++) {
			if (myRun !== writeRunId) return;
			renderFrame(visible, false);
			await new Promise((r) => setTimeout(r, 260));
		}
		if (myRun !== writeRunId) return;
		renderFrame(Math.min(picked.length, 8), true);
	}

	function renderRun(): void {
		if (state.installPhase === 'running' || state.installPhase === 'failed') {
			renderInstalling();
		} else if (state.installPhase === 'done') {
			renderInstallDone();
		} else {
			renderRunPrompt();
		}
		renderHelpPanel();
		updateReadout();
	}

	function renderRunPrompt(): void {
		const lines: string[] = [];
		const picked = flat.filter((f) => state.picked.has(f.cmd.id));

		lines.push(`<span class="t-accent">script ready.</span>`);
		lines.push('');
		lines.push(
			`<span class="t-muted">run now?</span>  <span class="t-accent">[y]</span> <span class="t-text">yes, install</span>     <span class="t-accent">[n]</span> <span class="t-muted">save & paste later</span>`,
		);
		lines.push('');
		lines.push(`<span class="t-dim">or later in Konsole:</span>`);
		lines.push(
			`  <span class="t-accent">$</span> <span class="t-text">bash /tmp/magus.sh</span>`,
		);
		lines.push('');
		lines.push(
			`<span class="t-dim">── preview ────────────────────────────────────</span>`,
		);
		lines.push(`<span class="t-muted">#!/usr/bin/env bash</span>`);
		lines.push(`<span class="t-muted"># magus.sh — ${picked.length} commands</span>`);
		lines.push('');
		const showPicks = picked.slice(0, 4);
		for (const f of showPicks) {
			lines.push(`<span class="t-dim"># ${esc(f.cmd.title)}</span>`);
			const firstCmd = f.cmd.commands[0];
			if (firstCmd) lines.push(`<span class="t-text">${esc(firstCmd.run)}</span>`);
			lines.push('');
		}
		if (picked.length > showPicks.length) {
			lines.push(`<span class="t-dim">… +${picked.length - showPicks.length} more</span>`);
		}
		if (picked.length === 0) {
			lines.push(`<span class="t-warn"># (nothing picked — go back and choose some commands)</span>`);
		}
		screens.run.innerHTML = renderLines(lines);
	}

	function renderInstalling(): void {
		const picked = flat.filter((f) => state.picked.has(f.cmd.id));
		const done = state.installLog.length;
		const total = picked.length;
		const current = picked[state.installLog.length];
		screens.run.innerHTML = progressPanel({
			title: 'Run script',
			done,
			total,
			current,
			log: state.installLog,
			failed: state.installPhase === 'failed',
		});
	}

	function renderInstallDone(): void {
		const lines: string[] = [];
		const done = state.installLog.filter((e) => e.result === 'done').length;
		const skipped = state.installLog.filter((e) => e.result === 'skipped').length;

		lines.push(`<span class="t-accent">ceremony complete ✓</span>`);
		lines.push('');
		lines.push(
			`  <span class="t-accent">${done}</span> <span class="t-text">installed</span>   <span class="t-dim">${skipped > 0 ? `${skipped} skipped` : ''}</span>`,
		);
		lines.push('');

		for (const entry of state.installLog) {
			const icon =
				entry.result === 'done'
					? `<span class="t-accent">✓</span>`
					: `<span class="t-dim">—</span>`;
			const title =
				entry.result === 'skipped'
					? `<span class="t-dim">${esc(entry.title)}</span>`
					: `<span class="t-muted">${esc(entry.title)}</span>`;
			lines.push(`  ${icon} ${title}`);
		}

		lines.push('');
		lines.push(`<span class="t-dim">──</span>`);
		lines.push(`<span class="t-dim">restart Steam for all changes to take effect</span>`);
		lines.push('');
		lines.push(
			`  <span class="t-accent">$</span> <span class="t-text">steam -shutdown && nohup steam &</span>`,
		);

		screens.run.innerHTML = renderLines(lines);
	}

	let installRunId = 0;
	const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

	async function startStageInstall(stageId: string): Promise<void> {
		const myId = ++installRunId;
		const stage = stages.find((s) => s.id === stageId);
		if (!stage) return;
		const stagePicks = flat.filter(
			(f) => f.stage.id === stageId && state.picked.has(f.cmd.id),
		);
		if (stagePicks.length === 0) return;

		state.installPhase = 'running';
		state.installIndex = 0;
		state.installLog = [];
		refreshHints();

		const failAt = stagePicks.length >= 4 ? 2 : -1;

		for (let i = 0; i < stagePicks.length; i++) {
			if (myId !== installRunId) return;
			state.installIndex = i;
			renderPick();
			await sleep(250 + Math.floor(Math.random() * 450));
			if (myId !== installRunId) return;
			if (i === failAt) {
				state.installPhase = 'failed';
				refreshHints();
				renderPick();
				return;
			}
			state.installLog.push({ title: stagePicks[i]!.cmd.title, result: 'done' });
		}

		if (myId !== installRunId) return;
		state.installPhase = 'done';
		state.installedStageIds.add(stageId);
		refreshHints();
		renderPick();
	}

	async function continueStageInstall(action: 'retry' | 'skip'): Promise<void> {
		const myId = ++installRunId;
		const stageId = state.currentStageId ?? '';
		const stagePicks = flat.filter(
			(f) => f.stage.id === stageId && state.picked.has(f.cmd.id),
		);
		state.installPhase = 'running';
		refreshHints();

		let i = state.installIndex;
		if (action === 'skip') {
			state.installLog.push({
				title: stagePicks[i]?.cmd.title ?? '?',
				result: 'skipped',
			});
			i++;
		} else {
			renderPick();
			await sleep(450 + Math.floor(Math.random() * 300));
			if (myId !== installRunId) return;
			state.installLog.push({ title: stagePicks[i]!.cmd.title, result: 'done' });
			i++;
		}

		for (; i < stagePicks.length; i++) {
			if (myId !== installRunId) return;
			state.installIndex = i;
			renderPick();
			await sleep(250 + Math.floor(Math.random() * 400));
			if (myId !== installRunId) return;
			state.installLog.push({ title: stagePicks[i]!.cmd.title, result: 'done' });
		}

		if (myId !== installRunId) return;
		state.installPhase = 'done';
		state.installedStageIds.add(stageId);
		refreshHints();
		renderPick();
	}

	async function startInstall(): Promise<void> {
		const myId = ++installRunId;
		const picked = flat.filter((f) => state.picked.has(f.cmd.id));
		state.installPhase = 'running';
		state.installIndex = 0;
		state.installLog = [];
		refreshHints();

		// Fail at index 3 if enough commands picked — realistic network failure demo
		const failAt = picked.length >= 4 ? 3 : -1;

		for (let i = 0; i < picked.length; i++) {
			if (myId !== installRunId) return;
			state.installIndex = i;
			renderRun();
			await sleep(250 + Math.floor(Math.random() * 450));
			if (myId !== installRunId) return;
			if (i === failAt) {
				state.installPhase = 'failed';
				refreshHints();
				renderRun();
				return; // keyboard handler takes over
			}
			state.installLog.push({ title: picked[i]!.cmd.title, result: 'done' });
		}

		if (myId !== installRunId) return;
		state.installPhase = 'done';
		refreshHints();
		renderRun();
	}

	async function continueInstall(action: 'retry' | 'skip'): Promise<void> {
		const myId = ++installRunId;
		const picked = flat.filter((f) => state.picked.has(f.cmd.id));
		state.installPhase = 'running';
		refreshHints();

		let i = state.installIndex;

		if (action === 'skip') {
			state.installLog.push({ title: picked[i]?.cmd.title ?? '?', result: 'skipped' });
			i++;
		} else {
			// Retry — show it running, then succeed
			renderRun();
			await sleep(500 + Math.floor(Math.random() * 300));
			if (myId !== installRunId) return;
			state.installLog.push({ title: picked[i]!.cmd.title, result: 'done' });
			i++;
		}

		for (; i < picked.length; i++) {
			if (myId !== installRunId) return;
			state.installIndex = i;
			renderRun();
			await sleep(250 + Math.floor(Math.random() * 400));
			if (myId !== installRunId) return;
			state.installLog.push({ title: picked[i]!.cmd.title, result: 'done' });
		}

		if (myId !== installRunId) return;
		state.installPhase = 'done';
		refreshHints();
		renderRun();
	}

	function moveCursor(delta: number): void {
		const n = rowCount();
		if (n === 0) return;
		state.cursor = Math.max(0, Math.min(n - 1, state.cursor + delta));
		if (state.pickView === 'menu') state.menuCursor = state.cursor;
		renderPick();
	}

	function spaceToggle(): void {
		if (state.step !== 'pick' || state.pickView !== 'stage') return;
		const stage = stages.find((s) => s.id === state.currentStageId);
		if (!stage) return;
		const row = stageRowsFor(stage)[state.cursor];
		if (row?.kind !== 'item') return;
		toggleId(row.cmd.id);
	}

	function toggleId(id: string): void {
		if (state.picked.has(id)) state.picked.delete(id);
		else state.picked.add(id);
		renderPick();
	}

	function activate(): void {
		if (state.step !== 'pick') return;
		if (state.pickView === 'menu') {
			const row = menuRows()[state.cursor];
			if (!row) return;
			if (row.kind === 'stage') {
				state.menuCursor = state.cursor;
				state.pickView = 'stage';
				state.currentStageId = row.stage.id;
				state.currentGroupId = null;
				state.cursor = 0;
				updateTitle();
				refreshHints();
				renderPick();
			} else if (row.kind === 'preset') {
				let added = 0;
				let already = 0;
				for (const cmd of presetMatches(row.preset)) {
					if (state.picked.has(cmd.id)) {
						already++;
					} else {
						state.picked.add(cmd.id);
						added++;
					}
				}
				setNotice(`${row.preset.name} applied · +${added} new · ${already} already picked`);
				renderPick();
			} else if (row.id === 'review') {
				setStep('review');
			} else if (row.id === 'write') {
				setStep('write');
			} else if (row.id === 'quit') {
				resetAll();
			}
		} else {
			const stage = stages.find((s) => s.id === state.currentStageId);
			if (!stage) return;
			const row = stageRowsFor(stage)[state.cursor];
			if (!row) return;
			if (row.kind === 'group') {
				state.currentGroupId = row.group.id;
				state.cursor = 0;
				updateTitle();
				renderPick();
			} else if (row.kind === 'back-group') {
				state.currentGroupId = null;
				state.cursor = 0;
				renderPick();
			} else if (row.kind === 'item') {
				toggleId(row.cmd.id);
			} else if (row.kind === 'select-all') {
				const allSelected = stage.items.every((c) => state.picked.has(c.id));
				if (allSelected) {
					stage.items.forEach((c) => state.picked.delete(c.id));
				} else {
					stage.items.forEach((c) => state.picked.add(c.id));
				}
				renderPick();
			} else if (row.kind === 'install') {
				const stagePicked = stage.items.filter((c) => state.picked.has(c.id)).length;
				if (stagePicked === 0) return;
				state.pickView = 'installing';
				updateTitle();
				refreshHints();
				void startStageInstall(stage.id);
			} else {
				goBackToMenu();
			}
		}
	}

	function goBackToMenu(): void {
		state.pickView = 'menu';
		state.currentStageId = null;
		state.currentGroupId = null;
		state.cursor = state.menuCursor;
		updateTitle();
		refreshHints();
		renderPick();
	}

	function nextStep(): void {
		const steps = activeSteps();
		const idx = steps.indexOf(state.step);
		if (idx < steps.length - 1) setStep(steps[idx + 1]);
	}
	function prevStep(): void {
		const steps = activeSteps();
		const idx = steps.indexOf(state.step);
		if (idx > 0) setStep(steps[idx - 1]);
	}

	function paintDeviceButtons(): void {
		for (const el of deviceButtons) {
			const is = el.dataset.device === state.device;
			el.classList.toggle('active', is);
			el.setAttribute('aria-checked', is ? 'true' : 'false');
		}
	}

	/** Switch device: rebuild the rail, reset the path, land on the splash. */
	function setDevice(next: Device): void {
		if (state.device === next) return;
		state.device = next;
		++state.convergeRunId; // cancel any in-flight converge animation
		state.manifest = defaultManifest();
		state.questionIndex = 0;
		state.driftRepaired = false;
		state.cursor = 0;
		paintDeviceButtons();
		buildFlowRail();
		setStep('splash');
	}
	function resetAll(): void {
		++installRunId;
		state.cursor = 0;
		state.menuCursor = 0;
		state.pickView = 'menu';
		state.currentStageId = null;
		state.currentGroupId = null;
		state.picked.clear();
		state.installedStageIds.clear();
		state.installPhase = 'prompt';
		state.installLog = [];
		state.installIndex = 0;
		state.notice = null;
		state.helpOpen = false;
		// machine path
		++state.convergeRunId;
		state.manifest = defaultManifest();
		state.questionIndex = 0;
		state.driftRepaired = false;
		window.clearTimeout(noticeTimer);
		seedDefaults();
		setStep('splash');
	}

	function seedDefaults(): void {
		const want = ['set-sudo-password', 'install-dependencies', 'protonup-qt', 'heroic'];
		for (const f of flat) {
			if (want.some((p) => matchPattern(f.cmd.id, p))) state.picked.add(f.cmd.id);
		}
	}

	window.addEventListener('keydown', (e) => {
		const target = e.target as HTMLElement | null;
		if (target && ['INPUT', 'TEXTAREA'].includes(target.tagName)) return;

		const k = e.key;

		if (k === 'r' || k === 'R') {
			resetAll();
			e.preventDefault();
			return;
		}
		if (k === '?') {
			state.helpOpen = !state.helpOpen;
			renderHelpPanel();
			refreshHints();
			e.preventDefault();
			return;
		}
		if (state.helpOpen) {
			if (k === 'Escape') {
				state.helpOpen = false;
				renderHelpPanel();
				refreshHints();
			}
			e.preventDefault();
			return;
		}
		if (k === 'ArrowLeft') {
			prevStep();
			e.preventDefault();
			return;
		}
		if (k === 'ArrowRight') {
			nextStep();
			e.preventDefault();
			return;
		}

		if (state.step === 'splash' && k === 'Enter') {
			nextStep();
			e.preventDefault();
			return;
		}

		// --- Steam Machine path ---
		if (state.step === 'wizard') {
			const q = QUESTIONS[state.questionIndex];
			if (k === 'ArrowDown') {
				state.cursor = Math.min(q.options.length - 1, state.cursor + 1);
				render();
			} else if (k === 'ArrowUp') {
				state.cursor = Math.max(0, state.cursor - 1);
				render();
			} else if (k === ' ' && q.multi) {
				const id = q.options[state.cursor].id;
				if (state.manifest.bundles.has(id)) state.manifest.bundles.delete(id);
				else state.manifest.bundles.add(id);
				render();
			} else if (k === 'Enter') {
				const opt = q.options[state.cursor];
				if (q.id === 'optimise') state.manifest.optimise = opt.id === 'yes';
				else if (!q.multi) {
					(state.manifest as unknown as Record<string, string>)[q.id] = opt.id;
				}
				if (state.questionIndex < QUESTIONS.length - 1) {
					state.questionIndex += 1;
					state.cursor = 0;
					updateTitle();
					refreshHints();
					render();
				} else {
					setStep('manifest');
				}
			} else {
				return;
			}
			e.preventDefault();
			return;
		}
		if (state.step === 'manifest' && k === 'Enter') {
			setStep('converge');
			e.preventDefault();
			return;
		}
		if (state.step === 'doctor' && (k === 'y' || k === 'Y')) {
			state.driftRepaired = true;
			refreshHints();
			render();
			e.preventDefault();
			return;
		}

		if (state.step === 'pick' && state.pickView === 'installing') {
			if (state.installPhase === 'failed') {
				if (k === 'y' || k === 'Y' || k === 'Enter') {
					void continueStageInstall('retry');
					e.preventDefault();
					return;
				}
				if (k === 's' || k === 'S') {
					void continueStageInstall('skip');
					e.preventDefault();
					return;
				}
				if (k === 'q' || k === 'Q') {
					state.installPhase = 'done';
					if (state.currentStageId) state.installedStageIds.add(state.currentStageId);
					refreshHints();
					renderPick();
					e.preventDefault();
					return;
				}
			} else if (state.installPhase === 'done' && (k === 'Escape' || k === 'Enter')) {
				goBackToMenu();
				e.preventDefault();
				return;
			}
			e.preventDefault(); // block all other keys while installing
			return;
		}

		if (state.step === 'pick') {
			// Search mode input
			if (state.pickView === 'search') {
				if (k === 'Escape') {
					state.pickView = state.priorView;
					state.cursor = state.pickView === 'menu' ? state.menuCursor : 0;
					state.searchQuery = '';
					updateTitle();
					refreshHints();
					renderPick();
					e.preventDefault();
					return;
				}
				if (k === 'Backspace') {
					state.searchQuery = state.searchQuery.slice(0, -1);
					updateSearch(state.searchQuery);
					refreshHints();
					e.preventDefault();
					return;
				}
				if (k === 'Enter') {
					// Toggle focused result
					const result = state.searchResults[state.cursor];
					if (result) toggleId(result.cmd.id);
					e.preventDefault();
					return;
				}
				if (k === ' ') {
					// Toggle focused result
					const result = state.searchResults[state.cursor];
					if (result) toggleId(result.cmd.id);
					e.preventDefault();
					return;
				}
				if (k.length === 1 && /[a-z0-9 \-]/i.test(k)) {
					state.searchQuery += k;
					updateSearch(state.searchQuery);
					e.preventDefault();
					return;
				}
				if (k === 'ArrowUp' || k === 'ArrowDown') {
					moveCursor(k === 'ArrowUp' ? -1 : 1);
					e.preventDefault();
					return;
				}
				return;
			}

			// Normal pick mode
			if (k === 'ArrowUp' || k === 'k') {
				moveCursor(-1);
				e.preventDefault();
				return;
			}
			if (k === 'ArrowDown' || k === 'j') {
				moveCursor(1);
				e.preventDefault();
				return;
			}
			if (k === ' ') {
				spaceToggle();
				e.preventDefault();
				return;
			}
			if (k === 'Enter') {
				activate();
				e.preventDefault();
				return;
			}
			if (k === '/' && state.pickView === 'menu') {
				state.priorView = 'menu';
				state.pickView = 'search';
				state.searchQuery = '';
				state.searchResults = flat;
				state.cursor = 0;
				refreshHints();
				renderPick();
				e.preventDefault();
				return;
			}
			if (k === '/' && state.pickView === 'stage') {
				state.priorView = 'stage';
				state.pickView = 'search';
				state.searchQuery = '';
				const stage = stages.find((s) => s.id === state.currentStageId);
				state.searchResults = stage
					? flat.filter((f) => f.stage.id === stage.id)
					: [];
				state.cursor = 0;
				refreshHints();
				renderPick();
				e.preventDefault();
				return;
			}
			if (k === 'Escape' && state.pickView === 'stage') {
				if (state.currentGroupId) {
					state.currentGroupId = null;
					state.cursor = 0;
					renderPick();
				} else {
					goBackToMenu();
				}
				e.preventDefault();
				return;
			}
		}

		if (state.step === 'review') {
			if (k === 'y' || k === 'Y') {
				nextStep();
				e.preventDefault();
				return;
			}
			if (k === 'e' || k === 'E') {
				setStep('pick');
				e.preventDefault();
				return;
			}
			if (k === 'q' || k === 'Q') {
				resetAll();
				e.preventDefault();
				return;
			}
			if (k === 'Enter') {
				nextStep();
				e.preventDefault();
				return;
			}
		}

		if (state.step === 'write' && k === 'Enter') {
			nextStep();
			e.preventDefault();
			return;
		}

		if (state.step === 'run') {
			if (state.installPhase === 'prompt') {
				if (k === 'y' || k === 'Y' || k === 'Enter') {
					void startInstall();
					e.preventDefault();
					return;
				}
				if (k === 'n' || k === 'N') {
					// nothing — script is already saved, just leave the screen
					e.preventDefault();
					return;
				}
			} else if (state.installPhase === 'failed') {
				if (k === 'y' || k === 'Y' || k === 'Enter') {
					void continueInstall('retry');
					e.preventDefault();
					return;
				}
				if (k === 's' || k === 'S') {
					void continueInstall('skip');
					e.preventDefault();
					return;
				}
				if (k === 'q' || k === 'Q') {
					state.installPhase = 'done';
					refreshHints();
					renderRun();
					e.preventDefault();
					return;
				}
			} else if (state.installPhase === 'done' && k === 'Enter') {
				setStep('splash');
				e.preventDefault();
				return;
			}
		}
	});

	for (const el of deviceButtons) {
		el.addEventListener('click', () => {
			const d = el.dataset.device;
			if (d === 'deck' || d === 'machine') setDevice(d);
		});
	}

	const flowToggle = document.querySelector<HTMLElement>('[data-flow-toggle]');
	flowToggle?.addEventListener('click', () => {
		state.flow = state.flow === 'wizard' ? 'picker' : 'wizard';
		flowToggle.textContent = state.flow === 'picker' ? 'back to the wizard' : 'show it';
		buildFlowRail();
		setStep('splash');
	});

	seedDefaults();
	paintDeviceButtons();
	buildFlowRail();
	setStep('splash');
</script>

