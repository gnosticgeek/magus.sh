---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';

const INSTALL_CMD = 'curl -fsSL https://magus.sh/run | bash';
---

<Base
	title="magus.sh — ten-minute setup"
	description="Your device, transmuted in ten minutes. Steam Deck setup now, Mac support coming soon."
>
	<div class="hp">
		<main class="hp-hero">
			<section class="hp-copy">
				<h1 class="hp-headline rise rise-1">
					Your device.<br />
					<em>Transmuted</em> in ten minutes.
				</h1>

				<p class="hp-lede rise rise-3">
					<strong>magus.sh</strong> turns a Steam Deck into a ready gaming
					setup with one repeatable paste. Mac support is coming soon.
				</p>

				<div class="hp-cta-row rise rise-3">
					<a class="hp-primary" href="/setup">
						<span>Start with Steam Deck</span>
						<span class="hp-primary-arrow" aria-hidden="true">→</span>
					</a>
					<a class="hp-text-link" href="/run">Read the script</a>
				</div>

				<ul class="hp-proof rise rise-4" aria-label="Setup qualities">
					<li>No telemetry</li>
					<li>Repeatable script</li>
					<li>About ten minutes</li>
				</ul>
			</section>

			<section class="hp-start rise rise-4" aria-label="Quick start">
				<div class="hp-start-head">
					<p class="hp-start-label">Quick start</p>
					<span class="hp-start-status">Recommended</span>
				</div>

				<div class="hp-devices rise rise-4" aria-label="Supported devices">
					<a class="hp-device hp-device-ready" href="/setup">
						<span class="hp-device-icon" aria-hidden="true">
							<Icon name="simple-icons:steamdeck" />
						</span>
						<span class="hp-device-body">
						<span class="hp-device-name">Steam Deck</span>
							<span class="hp-device-copy">Optimised path</span>
						</span>
						<span class="hp-device-pill">Ready</span>
					</a>

					<a class="hp-device hp-device-beta" href="/mac">
						<span class="hp-device-icon" aria-hidden="true">
							<Icon name="simple-icons:apple" />
						</span>
						<span class="hp-device-body">
							<span class="hp-device-name">Mac</span>
							<span class="hp-device-copy">Beta</span>
						</span>
						<span class="hp-device-pill">Beta</span>
					</a>
				</div>

				<ol class="hp-flow" aria-label="How it works">
					<li>
						<span class="hp-flow-num">01</span>
						<span>
							<strong>Pick</strong>
							<small>Choose your setup</small>
						</span>
					</li>
					<li>
						<span class="hp-flow-num">02</span>
						<span>
							<strong>Copy</strong>
							<small>One command</small>
						</span>
					</li>
					<li>
						<span class="hp-flow-num">03</span>
						<span>
							<strong>Run</strong>
							<small>Walk away</small>
						</span>
					</li>
				</ol>

				<div class="hp-term">
					<div class="hp-term-head">
						<div class="hp-term-tag">
							Linux &amp; SteamOS
							<span class="sep">·</span>
							<span class="muted">paste in Konsole</span>
						</div>
						<span class="hp-term-pill">~ 10 min</span>
					</div>
					<div class="hp-term-body">
						<div class="hp-term-cmd">
							<span class="prompt">$</span><code data-hp-install-cmd>{INSTALL_CMD}</code>
						</div>
						<button
							class="hp-copy-btn"
							type="button"
							data-hp-install-copy
							aria-label="Copy install command"
						>
							<Icon name="lucide:copy" class="hp-copy-icon" />
							<span data-hp-install-copy-label>Copy</span>
						</button>
					</div>
				</div>

				<nav class="hp-secondary rise rise-5" aria-label="Secondary actions">
					<a class="hp-link" href="/setup">
						<span class="glyph">/</span>
						<span>Open command picker</span>
						<span class="arrow" aria-hidden="true">→</span>
					</a>
					<a
						class="hp-link"
						href="https://github.com/gnosticgeek/magus.sh"
						target="_blank"
						rel="noopener noreferrer"
					>
						<Icon name="simple-icons:github" class="hp-link-icon" />
						<span>Source</span>
					</a>
				</nav>
			</section>
		</main>
	</div>
</Base>

<script>
	const card = document.querySelector<HTMLElement>('.hp-term');
	const btn = card?.querySelector<HTMLButtonElement>('[data-hp-install-copy]');
	const target = card?.querySelector<HTMLElement>('[data-hp-install-cmd]');
	const btnLabel = card?.querySelector<HTMLElement>('[data-hp-install-copy-label]');

	if (card && btn && target && btnLabel) {
		btn.addEventListener('click', async () => {
			const text = target.textContent?.trim() ?? '';
			if (!text) return;
			try {
				await navigator.clipboard.writeText(text);
				btn.dataset.copied = 'true';
				card.dataset.copied = 'true';
				btnLabel.textContent = 'Copied';
				setTimeout(() => {
					delete btn.dataset.copied;
					delete card.dataset.copied;
					btnLabel.textContent = 'Copy';
				}, 1400);
			} catch {
				btnLabel.textContent = 'Press ⌘C';
				setTimeout(() => {
					btnLabel.textContent = 'Copy';
				}, 1400);
			}
		});
	}
</script>

<style>
	/* ----- shell --------------------------------------------------- */
	.hp {
		max-width: 1280px;
		margin: 0 auto;
		padding: clamp(18px, 2.2vw, 30px) clamp(20px, 4vw, 40px) 56px;
		position: relative;
		isolation: isolate;
		background-image:
			radial-gradient(60rem 40rem at 18% 22%, var(--color-glow-primary), transparent 70%),
			radial-gradient(50rem 36rem at 82% 10%, var(--color-glow-secondary), transparent 75%);
	}

	/* ----- hero ---------------------------------------------------- */
	.hp-hero {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(390px, 0.72fr);
		gap: clamp(44px, 7vw, 96px);
		align-items: start;
		margin-top: clamp(8px, 2.2vh, 24px);
	}

	.hp-copy,
	.hp-start {
		min-width: 0;
	}
	.hp-start {
		padding-top: clamp(6px, 2.5vh, 28px);
	}
	.hp-start-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 12px;
	}
	.hp-start-label {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-text-dim);
	}
	.hp-start-status {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
		padding: 5px 8px;
		border: 1px solid color-mix(in oklab, var(--color-accent) 48%, var(--color-border));
		border-radius: 999px;
		background: color-mix(in oklab, var(--color-accent) 9%, transparent);
		white-space: nowrap;
	}
	.hp-start-status::before {
		content: '';
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: currentColor;
		box-shadow: 0 0 10px currentColor;
	}
	@media (max-width: 980px) {
		.hp-hero {
			grid-template-columns: 1fr;
			gap: 34px;
			max-width: 760px;
			margin-top: clamp(12px, 4vw, 28px);
		}
		.hp-start {
			padding-top: 0;
		}
	}

	/* ----- headline — Geist Mono w/ Fraunces italic accent --------- */
	.hp-headline {
		margin: 0;
		font-family: 'Geist Mono', var(--font-mono);
		font-weight: 500;
		font-size: clamp(3rem, 5.8vw, 5.4rem);
		line-height: 1.02;
		letter-spacing: -0.045em;
		color: var(--color-text);
		text-wrap: balance;
		max-width: 12ch;
		font-feature-settings: 'ss01', 'ss02', 'cv11', 'zero';
	}
	.hp-headline em {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 400;
		font-size: 1.18em;
		font-variation-settings: 'opsz' 144, 'SOFT' 50, 'WONK' 1;
		letter-spacing: -0.02em;
		padding: 0 0.06em 0 0.04em;
		line-height: 0.85;
		/* alchemical sweep: accent → warn → danger — same triad the
		   footer wordmark uses, so it adapts per theme automatically. */
		color: var(--color-accent);
		background: linear-gradient(
			100deg,
			var(--color-accent) 0%,
			var(--color-warn) 55%,
			var(--color-danger) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		filter: drop-shadow(
			0 0 24px color-mix(in oklab, var(--color-accent) 22%, transparent)
		);
	}

	/* ----- lede + kicker ------------------------------------------ */
	.hp-lede {
		font-family: var(--font-sans);
		font-size: 1.0625rem;
		line-height: 1.55;
		color: var(--color-text-muted);
		max-width: 42ch;
		margin: 28px 0 0;
		text-wrap: pretty;
	}
	.hp-lede strong {
		color: var(--color-text);
		font-weight: 500;
	}
	.hp-cta-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 26px;
	}
	.hp-primary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		min-height: 44px;
		padding: 0 18px;
		border-radius: 8px;
		border: 1px solid color-mix(in oklab, var(--color-accent) 72%, var(--color-border));
		background: color-mix(in oklab, var(--color-accent) 13%, transparent);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease,
			transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.hp-primary:hover {
		border-color: var(--color-accent);
		background: color-mix(in oklab, var(--color-accent) 18%, transparent);
		transform: translateY(-1px);
	}
	.hp-primary:focus-visible,
	.hp-text-link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}
	.hp-primary-arrow {
		color: var(--color-accent);
		transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.hp-primary:hover .hp-primary-arrow {
		transform: translateX(3px);
	}
	.hp-text-link {
		font-family: var(--font-sans);
		font-size: 0.925rem;
		color: var(--color-text-muted);
		text-decoration: none;
	}
	.hp-text-link:hover {
		color: var(--color-text);
	}
	.hp-proof {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px 18px;
		margin: 22px 0 0;
		padding: 0;
		list-style: none;
		color: var(--color-text-dim);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.hp-proof li {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.hp-proof li::before {
		content: '';
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--color-accent);
		opacity: 0.7;
	}

	/* ----- device tiles ------------------------------------------- */
	.hp-devices {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		max-width: 100%;
		margin-top: 0;
	}
	.hp-device {
		position: relative;
		display: grid;
		grid-template-columns: 34px minmax(0, 1fr) auto;
		align-items: center;
		gap: 13px;
		min-height: 76px;
		padding: 13px 14px;
		border: 1px solid color-mix(in oklab, var(--color-border) 78%, transparent);
		border-radius: 8px;
		background:
			linear-gradient(
				135deg,
				color-mix(in oklab, var(--color-bg-elevated) 88%, transparent),
				color-mix(in oklab, var(--color-bg) 72%, transparent)
			);
		color: inherit;
		text-decoration: none;
		overflow: hidden;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease,
			transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.hp-device::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			color-mix(in oklab, var(--color-accent) 15%, transparent),
			transparent 42%
		);
		opacity: 0;
		transition: opacity 0.2s ease;
		pointer-events: none;
	}
	.hp-device-ready:hover {
		border-color: color-mix(in oklab, var(--color-accent) 68%, var(--color-border));
		transform: translateY(-2px);
	}
	.hp-device-ready {
		border-color: color-mix(in oklab, var(--color-accent) 44%, var(--color-border));
		box-shadow: 0 14px 40px -30px color-mix(in oklab, var(--color-accent) 70%, transparent);
	}
	.hp-device-ready::after {
		content: '✓';
		position: absolute;
		top: 9px;
		right: 10px;
		display: grid;
		place-items: center;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		color: var(--color-bg);
		background: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 700;
		line-height: 1;
		box-shadow: 0 0 16px color-mix(in oklab, var(--color-accent) 52%, transparent);
	}
	.hp-device-ready:hover::before {
		opacity: 1;
	}
	/* beta: live but work-in-progress — accent-tinted, no ✓ checkmark */
	.hp-device-beta {
		border-color: color-mix(in oklab, var(--color-accent) 30%, var(--color-border));
	}
	.hp-device-beta:hover {
		border-color: color-mix(in oklab, var(--color-accent) 60%, var(--color-border));
		transform: translateY(-2px);
	}
	.hp-device-beta:hover::before {
		opacity: 1;
	}
	.hp-device-beta .hp-device-copy {
		color: var(--color-accent);
	}
	.hp-device-beta .hp-device-pill {
		color: var(--color-accent);
		border-color: color-mix(in oklab, var(--color-accent) 42%, var(--color-border));
		background: color-mix(in oklab, var(--color-accent) 8%, transparent);
	}
	.hp-device:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}
	.hp-device-soon {
		opacity: 0.68;
		background: color-mix(in oklab, var(--color-bg-elevated) 52%, transparent);
	}
	.hp-device-icon {
		position: relative;
		width: 34px;
		height: 34px;
		display: grid;
		place-items: center;
		border-radius: 8px;
		color: var(--color-accent);
		background: color-mix(in oklab, var(--color-accent) 12%, transparent);
	}
	.hp-device-soon .hp-device-icon {
		color: var(--color-text-dim);
		background: color-mix(in oklab, var(--color-border) 45%, transparent);
	}
	.hp-device-icon :global(svg) {
		width: 18px;
		height: 18px;
	}
	.hp-device-body {
		position: relative;
		display: grid;
		gap: 4px;
		min-width: 0;
	}
	.hp-device-name {
		font-family: var(--font-sans);
		font-size: 0.98rem;
		font-weight: 500;
		color: var(--color-text);
		line-height: 1.1;
	}
	.hp-device-copy {
		font-family: var(--font-mono);
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-text-dim);
		line-height: 1.2;
	}
	.hp-device-ready .hp-device-copy {
		color: var(--color-accent);
	}
	.hp-device-ready .hp-device-pill {
		color: var(--color-accent);
		border-color: color-mix(in oklab, var(--color-accent) 52%, var(--color-border));
		background: color-mix(in oklab, var(--color-accent) 10%, transparent);
	}
	.hp-device-pill {
		position: relative;
		align-self: start;
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--color-text-dim);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 4px 7px;
		border: 1px solid color-mix(in oklab, var(--color-border) 75%, transparent);
		border-radius: 999px;
		background: color-mix(in oklab, var(--color-bg) 56%, transparent);
		white-space: nowrap;
	}
	@media (max-width: 640px) {
		.hp-devices {
			grid-template-columns: 1fr;
		}
	}

	/* ----- process strip ------------------------------------------ */
	.hp-flow {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
	}
	.hp-flow li {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 9px;
		align-items: center;
		min-height: 58px;
		padding: 10px 11px;
		border: 1px solid color-mix(in oklab, var(--color-border) 62%, transparent);
		border-radius: 8px;
		background: color-mix(in oklab, var(--color-bg-elevated) 42%, transparent);
	}
	.hp-flow li + li::before {
		content: '';
		position: absolute;
		top: 50%;
		left: -9px;
		width: 9px;
		height: 1px;
		background: color-mix(in oklab, var(--color-accent) 45%, var(--color-border));
	}
	.hp-flow-num {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.08em;
		color: var(--color-accent);
	}
	.hp-flow strong,
	.hp-flow small {
		display: block;
		overflow-wrap: anywhere;
	}
	.hp-flow strong {
		font-family: var(--font-sans);
		font-size: 0.86rem;
		font-weight: 500;
		color: var(--color-text);
		line-height: 1.1;
	}
	.hp-flow small {
		margin-top: 3px;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-dim);
		line-height: 1.2;
	}
	@media (max-width: 420px) {
		.hp-flow {
			grid-template-columns: 1fr;
		}
		.hp-flow li + li::before {
			display: none;
		}
	}

	/* ----- terminal card ------------------------------------------ */
	.hp-term {
		margin-top: 16px;
		max-width: 100%;
		border: 1px solid var(--color-border);
		background: color-mix(in oklab, var(--color-bg-elevated) 75%, transparent);
		border-radius: 12px;
		padding: 16px;
		position: relative;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.hp-term::before {
		content: '';
		position: absolute;
		top: 0;
		left: 16px;
		right: 16px;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			var(--color-accent),
			transparent
		);
		opacity: 0.3;
		transition: opacity 0.2s ease;
	}
	.hp-term[data-copied='true'] {
		border-color: color-mix(in oklab, var(--color-accent) 64%, var(--color-border));
		box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-accent) 24%, transparent);
	}
	.hp-term[data-copied='true']::before {
		opacity: 0.72;
	}
	.hp-term-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 14px;
		gap: 12px;
	}
	.hp-term-tag {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-text-dim);
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}
	.hp-term-tag .sep {
		opacity: 0.45;
		margin: 0 8px;
	}
	.hp-term-tag .muted {
		color: var(--color-text-dim);
		text-transform: none;
		letter-spacing: 0;
		font-style: italic;
	}
	.hp-term-pill {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-text-muted);
		letter-spacing: 0.08em;
		padding: 4px 9px;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: color-mix(in oklab, var(--color-bg) 50%, transparent);
		white-space: nowrap;
	}
	.hp-term-body {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 13px 14px;
		border-radius: 10px;
		background: color-mix(in oklab, var(--color-bg) 75%, transparent);
		border: 1px solid color-mix(in oklab, var(--color-border) 70%, transparent);
	}
	.hp-term-cmd {
		font-family: var(--font-mono);
		font-size: clamp(0.86rem, 1vw, 1rem);
