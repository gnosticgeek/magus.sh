---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import ActionLink from '../components/ActionLink.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PlatformCards from '../components/PlatformCards.astro';
import TerminalPreview from '../components/TerminalPreview.astro';
import WorkflowDemo from '../components/WorkflowDemo.astro';
import AuroraText from '../components/AuroraText.astro';
const benefits = [
  { icon: 'lucide:sliders-horizontal', title: 'Opinionated. Still yours.', copy: 'A considered starting point for apps and desktop preferences. Choose what fits the way you use your device.' },
  { icon: 'lucide:file-code-2', title: 'A setup you can read.', copy: 'Your choices live in a local manifest. The installer and source are open to inspect, from the first command onward.' },
  { icon: 'lucide:refresh-cw', title: 'Built to run again.', copy: 'Check for drift with doctor, then use reconcile to restore supported parts of your setup after they change.' },
];
const faqs = [
  ['What is Magus?', 'Magus is an open-source setup tool for SteamOS devices and Mac. It brings selected apps and preferences into a guided terminal flow, with a saved manifest for repeatable setup.'],
  ['Does the install command change my settings?', 'It downloads and verifies the Magus binary. On Mac it can open the menu when a terminal is available; settings and apps still change only after you review and apply your choices.'],
  ['Is Steam Machine support ready?', 'The Steam Machine path is available in alpha. Hardware detection is still unverified on real Steam Machine hardware. HDMI colour range, HDMI-CEC, and the performance power profile are recorded preferences but are not applied yet.'],
  ['Can I use it on Linux or Mac?', 'The Mac source alpha includes Homebrew apps, updates, reversible settings and portable app setups. General Linux support is still coming soon; a Linux-compatible binary is not a promise of support for every distribution.'],
  ['Can I choose individual commands instead?', 'Yes. The advanced Steam Deck command picker lets you select tools, inspect their commands, and review a generated script. It remains a separate option from the guided terminal setup.'],
  ['Is there a desktop app?', 'A desktop interface is being explored. It is not part of this release; the terminal tool is the main setup experience.'],
];
---
<Base>
  <div class="site-frame">
    <section class="hero">
      <div class="hero-copy">
        <a href="/steam" class="announcement"><span>ALPHA</span> Now for Steam devices <span aria-hidden="true">↗</span></a>
        <h1>Your device.<br /><span class="hero-title-line">Your kind of <span class="hero-magic"><AuroraText>magic</AuroraText>.</span></span></h1>
        <p class="hero-lede">A thoughtful setup for your Steam device or Mac. The apps you want. The little details, handled. All in one open-source tool.</p>
        <div class="action-row"><ActionLink href="/start">Get started</ActionLink><a class="text-link" href="#how-it-works">See how it works <span aria-hidden="true">↓</span></a></div>
        <p class="hero-footnote"><span aria-hidden="true">◇</span> Free & open source <span>·</span> No telemetry</p>
      </div>
      <div class="hero-visual"><div class="hero-orbit" aria-hidden="true"></div><TerminalPreview /></div>
    </section>
    <section class="platform-section" aria-label="Choose your platform"><PlatformCards /></section>
    <section class="site-section" id="how-it-works">
      <SectionHeading eyebrow="LESS SETUP. MORE POSSIBILITY." title="A few steps. A fresh start." description="From the first install to the next system update, your setup has a home." />
      <WorkflowDemo />
    </section>
    <section class="tools-section" aria-labelledby="tools-title">
      <div><p class="eyebrow">GOOD COMPANY</p><h2 id="tools-title">Tools you already know.</h2><p>Explore these and more in the <a href="/setup">advanced command picker ↗</a>.</p></div>
      <div class="tool-list" aria-label="Tools in the web command catalogue"><span><Icon name="lucide:gamepad-2" />Heroic</span><span><Icon name="lucide:layers" />Lutris</span><span><Icon name="lucide:package" />Flatpak</span><span><Icon name="simple-icons:firefoxbrowser" />Firefox</span><span><Icon name="lucide:radio" />OBS Studio</span><span><Icon name="lucide:shield-check" />Bitwarden</span></div>
    </section>
    <section class="site-section">
      <SectionHeading eyebrow="A LITTLE MORE CONSIDERED" title="Your setup. On your terms." />
      <div class="benefit-grid">{benefits.map(b => <article><div class="benefit-icon"><Icon name={b.icon} aria-hidden="true" /></div><h3>{b.title}</h3><p>{b.copy}</p></article>)}</div>
    </section>
    <section class="site-section faq-section" id="faq">
      <SectionHeading eyebrow="A FEW THINGS TO KNOW" title="Before you begin." description="Small tool. Clear expectations." />
      <div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
    </section>
    <section class="closing-cta"><span class="eyebrow">READY WHEN YOU ARE</span><h2>Make yourself at home.</h2><p>Your next setup starts with Magus.</p><ActionLink href="/start">Get started with Magus</ActionLink><small>Steam devices in alpha. Mac source alpha available. General Linux support on the way.</small></section>
  </div>
</Base>

<style>
  .hero { position: relative; }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 75% 38%, #9575ed09, transparent 60%);
  }
  .hero-copy, .hero-visual { position: relative; }
  .hero-title-line { color: #e1dbef; }
  .hero-magic { white-space: nowrap; }
  .hero-orbit {
    background: radial-gradient(ellipse at 35% 40%, #ad80f321, transparent 62%),
      radial-gradient(ellipse at 80% 65%, #7dd3fc0c, transparent 60%);
  }
  .hero :global(.action-link) {
    box-shadow: 0 3px 16px #a78bfa16, inset 0 1px 0 #ffffff30;
    transition: background .2s, box-shadow .2s, transform .2s;
  }
  .hero :global(.action-link:hover) {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px #a78bfa30, inset 0 1px 0 #ffffff40;
  }
  .announcement { transition: background .2s, border-color .2s; }
  .announcement:hover { background: #272034; border-color: #796398; }
  @media (prefers-reduced-motion: reduce) {
    .hero :global(.action-link:hover) { transform: none; }
  }
</style>
