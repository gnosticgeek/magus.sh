---
import '../styles/global.css';
import '../styles/site.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
}

const {
	title = 'Magus — Make your device yours',
	description = 'An opinionated setup tool for Steam Deck and Steam Machine. Install Magus, choose your setup, and make your device yours.',
	canonical,
} = Astro.props;

const GITHUB_URL = 'https://github.com/gnosticgeek/magus.sh';

const canonicalHref =
	canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'https://magus.sh').toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#0b0c0f" />
		<meta name="format-detection" content="telephone=no, address=no, email=no" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="magus.sh" />
		<link rel="canonical" href={canonicalHref} />
		<link rel="icon" type="image/svg+xml" href="/magus-mark.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalHref} />
		<meta property="og:site_name" content="magus.sh" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;550;600;650;700&family=Geist+Mono:wght@400;500;600&display=swap"
		/>

		<title>{title}</title>

	</head>
	<body class:list={["font-sans", { "has-picker": Astro.url.pathname.replace(/\/+$/, "") === "/setup" }]}>
		<Navbar githubUrl={GITHUB_URL} />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer githubUrl={GITHUB_URL} />
	</body>
</html>
