---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import CommandCard from './CommandCard.astro';

interface GroupMeta {
	label: string;
	tagline: string;
	icon: string;
}

interface Props {
	groupKey: string;
	parentNumber: string;
	letter: string;
	meta: GroupMeta;
	entries: CollectionEntry<'commands'>[];
}

const { groupKey, parentNumber, letter, meta, entries } = Astro.props;
const count = entries.length;
---

<section class="group-block" data-group={groupKey} aria-labelledby={`group-${groupKey}-title`}>
	<header class="group-header">
		<span class="group-eyebrow-num" aria-hidden="true">{parentNumber}·{letter.toUpperCase()}</span>
		<Icon name={meta.icon} class="group-title-icon" aria-hidden="true" />
		<h3 class="group-title" id={`group-${groupKey}-title`}>{meta.label}</h3>
		<span class="group-tagline" aria-hidden="true">{meta.tagline}</span>
		<span class="group-count" aria-hidden="true">{count} apps</span>
		<button
			type="button"
			class="section-select group-select"
			data-section-id={groupKey}
			data-state="none"
			aria-label={`Select all in ${meta.label}`}
		>
			<span class="icon" aria-hidden="true"></span>
			<span class="label">select all</span>
		</button>
	</header>

	<div class="group-grid">
		{entries.map((entry) => <CommandCard entry={entry} />)}
	</div>
</section>

<style>
	.group-block {
		position: relative;
		margin-top: 1.5rem;
	}
	.group-block:first-child {
		margin-top: 0.5rem;
	}

	.group-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem 0.65rem;
		padding: 0.4rem 0 0.55rem;
		margin-bottom: 0.65rem;
		border-bottom: 1px solid color-mix(in oklab, var(--color-border) 75%, transparent);
	}

	.group-eyebrow-num {
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-accent-dim);
		padding: 2px 6px;
		border: 1px solid color-mix(in oklab, var(--color-accent-dim) 35%, transparent);
		border-radius: 4px;
	}

	.group-title-icon {
		width: 16px;
		height: 16px;
		color: var(--color-accent);
		opacity: 0.85;
		flex-shrink: 0;
	}

	.group-title {
		font-family: var(--font-sans);
		font-size: 0.98rem;
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.005em;
		color: var(--color-text);
		margin: 0;
	}

	.group-tagline {
		font-size: 0.82rem;
		line-height: 1.4;
		color: var(--color-text-muted);
		flex: 1;
		min-width: 12ch;
	}
	@media (max-width: 640px) {
		.group-tagline { display: none; }
	}

	.group-count {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-text-dim);
	}

	.group-select {
		margin-left: auto;
		font-size: 11px;
	}

	.group-grid {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		gap: 0.75rem;
		align-items: start;
	}
	@media (min-width: 640px) {
		.group-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1024px) {
		.group-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
