---
import { PLATFORMS } from '../lib/platforms';
interface Props { githubUrl?: string; }
const { githubUrl = 'https://github.com/gnosticgeek/magus.sh' } = Astro.props;
---
<footer class="site-footer">
  <div class="footer-grid">
    <div><a class="brand" href="/"><img src="/magus-mark.svg" alt="" width="23" height="25" />magus.sh</a><p>A little setup. A lot more yours.</p><span class="status-badge live">Open source · Alpha</span></div>
    <nav aria-label="Platforms"><h2>Platforms</h2>{PLATFORMS.map(p => <a href={p.href}>{p.name}{!p.available && <small>Coming soon</small>}</a>)}</nav>
    <nav aria-label="Resources"><h2>Resources</h2><a href="/steam">Installation guide</a><a href="/setup">Advanced command picker</a><a href={githubUrl}>Source on GitHub ↗</a><a href="/install">Read the installer</a></nav>
    <nav aria-label="Labs"><h2>Labs</h2><a href="/tui">Terminal prototype</a><a href="/test">Steam Machine test bench</a><p>Experiments, not shipped features.</p></nav>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Magus. MIT licensed.</span><span>Built on the work of the open-source community.</span></div>
</footer>
