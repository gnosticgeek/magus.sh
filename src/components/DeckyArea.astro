---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import CommandCard from './CommandCard.astro';

interface Props {
	entries: CollectionEntry<'commands'>[];
}

const { entries } = Astro.props;

const installEntry = entries.find((e) => e.data.tags?.includes('prerequisite'));
const plugins = entries.filter((e) => !e.data.tags?.includes('prerequisite'));
const count = entries.length;
const pluginCount = plugins.length;
---

<div class="decky-area" data-area="decky">
	<div class="decky-grid-bg" aria-hidden="true"></div>
	<div class="decky-corner decky-corner-tl" aria-hidden="true"></div>
	<div class="decky-corner decky-corner-tr" aria-hidden="true"></div>
	<div class="decky-corner decky-corner-bl" aria-hidden="true"></div>
	<div class="decky-corner decky-corner-br" aria-hidden="true"></div>

	<header class="decky-header">
		<div class="decky-eyebrow">
			<span class="decky-eyebrow-dot" aria-hidden="true"></span>
			<span class="decky-eyebrow-text">/ within customise · sub-area a</span>
			<span class="decky-eyebrow-rule" aria-hidden="true"></span>
		</div>

		<div class="decky-title-wrap">
			<div class="decky-icon" aria-hidden="true">
				<Icon name="lucide:puzzle" class="h-6 w-6" />
			</div>
			<div class="min-w-0 flex-1">
				<h3 class="decky-title">
					Decky Loader
					<em class="decky-title-em">plugins</em>
				</h3>
				<p class="decky-tagline">
					Loader first, plugins after.
				</p>
			</div>
		</div>

		<div class="decky-meta">
			<button
				type="button"
				class="section-select decky-select-all"
				data-section-id="decky"
				data-state="none"
				aria-label="Select all in Decky area"
			>
				<span class="icon" aria-hidden="true"></span>
				<span class="label">select all</span>
			</button>
			<span class="decky-meta-count">{pluginCount} plugins · 1 loader</span>
		</div>
	</header>

	{
		installEntry && (
			<div class="decky-loader-row">
				<div class="decky-loader-label">
					<span class="decky-loader-num">00</span>
					<span class="decky-loader-text">the loader</span>
					<span class="decky-loader-rule" aria-hidden="true" />
				</div>
				<div class="decky-loader-card">
					<CommandCard entry={installEntry} />
				</div>
			</div>
		)
	}

	{
		plugins.length > 0 && (
			<div class="decky-plugins-row">
				<div class="decky-loader-label">
					<span class="decky-loader-num">01</span>
					<span class="decky-loader-text">recommended plugins</span>
					<span class="decky-loader-rule" aria-hidden="true" />
				</div>
				<div class="decky-plugins-grid">
					{plugins.map((entry) => (
						<CommandCard entry={entry} />
					))}
				</div>
			</div>
		)
	}
</div>

<style>
	.decky-area {
		position: relative;
		margin-top: 1rem;
		padding: 1.75rem 1.5rem 2rem;
		border: 1px solid var(--color-border);
		border-radius: 14px;
		background:
			radial-gradient(
				120% 80% at 0% 0%,
				color-mix(in oklab, var(--color-accent) 5%, transparent),
				transparent 55%
			),
			linear-gradient(
				180deg,
				color-mix(in oklab, var(--color-bg-elevated) 60%, transparent),
				color-mix(in oklab, var(--color-bg-elevated) 30%, transparent)
			);
		overflow: hidden;
		isolation: isolate;
	}

	.decky-area::before {
		content: "";
		position: absolute;
		top: 0;
		left: 5%;
		right: 5%;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			var(--color-accent),
			transparent
		);
		opacity: 0.35;
	}

	.decky-grid-bg {
		position: absolute;
		inset: 0;
		z-index: -1;
		opacity: 0.4;
		background-image:
			linear-gradient(
				to right,
				color-mix(in oklab, var(--color-border) 35%, transparent) 1px,
				transparent 1px
			),
			linear-gradient(
				to bottom,
				color-mix(in oklab, var(--color-border) 35%, transparent) 1px,
				transparent 1px
			);
		background-size: 32px 32px;
		mask-image: radial-gradient(
			ellipse 90% 70% at 50% 30%,
			rgba(0, 0, 0, 0.85),
			transparent 70%
		);
	}

	.decky-corner {
		position: absolute;
		width: 10px;
		height: 10px;
		border-color: var(--color-accent);
		opacity: 0.5;
	}
	.decky-corner-tl {
		top: 6px;
		left: 6px;
		border-top: 1px solid;
		border-left: 1px solid;
	}
	.decky-corner-tr {
		top: 6px;
		right: 6px;
		border-top: 1px solid;
		border-right: 1px solid;
	}
	.decky-corner-bl {
		bottom: 6px;
		left: 6px;
		border-bottom: 1px solid;
		border-left: 1px solid;
	}
	.decky-corner-br {
		bottom: 6px;
		right: 6px;
		border-bottom: 1px solid;
		border-right: 1px solid;
	}

	.decky-header {
		margin-bottom: 1.5rem;
	}

	.decky-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.22em;
		color: var(--color-accent-dim);
	}
	.decky-eyebrow-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 8px var(--color-accent);
		flex-shrink: 0;
	}
	.decky-eyebrow-text {
		color: var(--color-text-dim);
	}
	.decky-eyebrow-rule {
		flex: 1;
		height: 1px;
		background: linear-gradient(
			90deg,
			color-mix(in oklab, var(--color-accent) 40%, transparent),
			transparent
		);
	}

	.decky-title-wrap {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		margin-top: 0.85rem;
	}

	.decky-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 9px;
		border: 1px solid color-mix(in oklab, var(--color-accent) 30%, var(--color-border));
		background:
			radial-gradient(
				circle at 30% 30%,
				color-mix(in oklab, var(--color-accent) 15%, transparent),
				transparent
			),
			color-mix(in oklab, var(--color-bg) 90%, transparent);
		color: var(--color-accent);
		flex-shrink: 0;
	}

	.decky-title {
		font-family: var(--font-sans);
		font-size: 1.85rem;
		font-weight: 500;
		line-height: 1.05;
		letter-spacing: -0.025em;
		color: var(--color-text);
		margin: 0;
	}
	.decky-title-em {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 400;
		color: var(--color-accent);
		margin-left: 0.25rem;
	}

	.decky-tagline {
		margin-top: 0.4rem;
		max-width: 58ch;
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--color-text-muted);
	}

	.decky-meta {
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
	}
	.decky-meta-count {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-text-dim);
		letter-spacing: 0.02em;
	}
	.decky-select-all {
		font-size: 11px;
	}

	.decky-howto {
		margin-top: 1.1rem;
		border: 1px dashed color-mix(in oklab, var(--color-border-strong) 80%, transparent);
		border-radius: 8px;
		background: color-mix(in oklab, var(--color-bg) 60%, transparent);
		font-family: var(--font-mono);
	}
	.decky-howto summary {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.7rem 0.85rem;
		cursor: pointer;
		list-style: none;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: var(--color-text-muted);
		transition: color 0.15s, background-color 0.15s;
	}
	.decky-howto summary::-webkit-details-marker {
		display: none;
	}
	.decky-howto summary:hover {
		color: var(--color-text);
		background-color: color-mix(in oklab, var(--color-surface) 50%, transparent);
	}
	.decky-howto[open] summary {
		color: var(--color-text);
		border-bottom: 1px dashed color-mix(in oklab, var(--color-border-strong) 80%, transparent);
	}
	.decky-howto-marker {
		display: inline-block;
		width: 13px;
		text-align: center;
		color: var(--color-accent);
		font-weight: 500;
		transition: transform 0.2s;
	}
	.decky-howto[open] .decky-howto-marker {
		transform: rotate(45deg);
	}
	.decky-howto-label {
		flex: 1;
		text-transform: none;
		letter-spacing: 0;
		font-family: var(--font-sans);
		font-size: 13px;
		color: var(--color-text);
	}
	.decky-howto-yes {
		padding: 2px 7px;
		border: 1px solid color-mix(in oklab, var(--color-accent) 40%, transparent);
		border-radius: 999px;
		color: var(--color-accent);
		font-size: 9.5px;
		font-weight: 600;
	}

	.decky-howto-body {
		padding: 0.9rem 0.95rem 1rem;
		font-family: var(--font-sans);
		font-size: 13.5px;
		line-height: 1.6;
		color: var(--color-text-muted);
	}
	.decky-howto-body p {
		margin: 0 0 0.6rem;
	}
	.decky-howto-body p:last-of-type {
		margin-bottom: 0.7rem;
	}
	.decky-howto-body code {
		font-family: var(--font-mono);
		font-size: 12px;
		padding: 1px 5px;
		border-radius: 3px;
		background: color-mix(in oklab, var(--color-bg) 80%, transparent);
		color: var(--color-text);
		border: 1px solid var(--color-border);
	}
	.decky-howto-snippet {
		margin: 0.45rem 0 0.75rem;
		padding: 0.7rem 0.85rem;
		border-radius: 6px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 11.5px;
		line-height: 1.55;
		color: var(--color-text);
		overflow-x: auto;
		white-space: pre;
	}
	.decky-howto-list {
		list-style: none;
		padding: 0;
		margin: 0.4rem 0 0;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 12.5px;
	}
	.decky-howto-list li {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}
	.decky-howto-bullet {
		color: var(--color-accent);
		font-family: var(--font-mono);
		flex-shrink: 0;
	}

	.decky-loader-row,
	.decky-plugins-row {
		margin-top: 1.5rem;
	}

	.decky-loader-label {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.65rem;
		font-family: var(--font-mono);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.24em;
		color: var(--color-text-dim);
	}
	.decky-loader-num {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 2px 6px;
		border: 1px solid var(--color-border-strong);
		border-radius: 3px;
		color: var(--color-accent-dim);
		font-weight: 500;
	}
	.decky-loader-text {
		color: var(--color-text-muted);
	}
	.decky-loader-rule {
		flex: 1;
		height: 1px;
		background: linear-gradient(
			90deg,
			var(--color-border-strong),
			transparent 80%
		);
	}

	.decky-loader-card {
		max-width: 540px;
	}
	.decky-loader-card :global(.card) {
		border-color: color-mix(in oklab, var(--color-accent) 25%, var(--color-border));
		background: color-mix(in oklab, var(--color-bg-elevated) 85%, transparent);
	}
	.decky-loader-card :global(.card:hover) {
		border-color: color-mix(in oklab, var(--color-accent) 50%, var(--color-border-strong));
	}

	.decky-plugins-grid {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		gap: 0.75rem;
		align-items: stretch;
		grid-auto-rows: 1fr;
		min-width: 0;
	}
	@media (min-width: 640px) {
		.decky-plugins-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1024px) {
		.decky-plugins-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.decky-area {
			padding: 1.4rem 1.1rem 1.6rem;
		}
		.decky-title {
			font-size: 1.55rem;
		}
		.decky-icon {
			width: 34px;
			height: 34px;
		}
	}
</style>
