---
import { Icon } from 'astro-icon/components';
import ThemeSwitcher from './ThemeSwitcher.astro';

interface Props {
	githubUrl?: string;
	ariaLabel?: string;
}

const { githubUrl = '#', ariaLabel = 'Site' } = Astro.props;
---

<a class="nav-skip" href="#main">Skip to content</a>

<header class="nav-header" data-nav-header>
	<nav class="nav-inner" aria-label={ariaLabel}>
		<a class="nav-brand" href="/" aria-label="magus.sh — home">
			<svg
				class="nav-brand-wand"
				viewBox="0 0 24 24"
				aria-hidden="true"
				focusable="false"
			>
				<defs>
					<linearGradient
						id="magus-wand-grad"
						x1="0"
						y1="22"
						x2="22"
						y2="2"
						gradientUnits="userSpaceOnUse"
					>
						<stop offset="0" class="wand-stop-a" />
						<stop offset="0.55" class="wand-stop-b" />
						<stop offset="1" class="wand-stop-c" />
					</linearGradient>
				</defs>
				<path
					d="M4 20 L14 10"
					stroke="url(#magus-wand-grad)"
					stroke-width="2.5"
					stroke-linecap="round"
					fill="none"
				></path>
				<path
					d="M17 3 L18.2 7.5 L22.7 8.7 L18.2 9.9 L17 14.4 L15.8 9.9 L11.3 8.7 L15.8 7.5 Z"
					fill="url(#magus-wand-grad)"
				></path>
				<circle class="wand-spark wand-spark-1" cx="6.5" cy="5.5" r="1.1"></circle>
				<circle class="wand-spark wand-spark-2" cx="2.5" cy="13" r="0.7"></circle>
				<circle class="wand-spark wand-spark-3" cx="20" cy="17" r="0.8"></circle>
			</svg>
			<span class="nav-brand-word">magus.sh</span>
			<span class="nav-brand-version" aria-hidden="true">v0.1</span>
		</a>

		<div class="nav-actions">
			<a
				class="nav-icon-btn"
				href={githubUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub repository (opens in new tab)"
			>
				<Icon name="simple-icons:github" class="nav-icon" />
			</a>
			<span class="nav-divider" aria-hidden="true"></span>
			<ThemeSwitcher />
		</div>
	</nav>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-nav-header]');
	if (header) {
		const onScroll = () => {
			header.setAttribute('data-scrolled', window.scrollY > 4 ? 'true' : 'false');
		};
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>

<style>
	.nav-skip {
		position: fixed;
		top: 8px;
		left: 8px;
		z-index: 80;
		padding: 8px 14px;
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-accent);
		border-radius: 6px;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 12px;
		text-decoration: none;
		transform: translateY(-200%);
		transition: transform 0.18s ease;
	}
	.nav-skip:focus-visible {
		transform: translateY(0);
		outline: none;
	}

	.nav-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in oklab, var(--color-bg-elevated) 82%, transparent);
		backdrop-filter: blur(18px) saturate(140%);
		-webkit-backdrop-filter: blur(18px) saturate(140%);
		border-bottom: 1px solid var(--color-border);
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.nav-header[data-scrolled='true'] {
		border-bottom-color: var(--color-border-strong);
		box-shadow: 0 8px 24px -16px rgba(0, 0, 0, 0.55);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		max-width: 80rem;
		margin: 0 auto;
		height: 56px;
		padding: 0 20px;
	}
	@media (min-width: 768px) {
		.nav-inner {
			height: 64px;
		}
	}

	.nav-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		isolation: isolate;
	}
	.nav-brand:focus-visible {
		outline: none;
	}

	.nav-brand-wand {
		width: 22px;
		height: 22px;
		flex-shrink: 0;
		filter: drop-shadow(0 0 6px color-mix(in oklab, var(--color-accent) 45%, transparent));
		transition:
			transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
			filter 0.25s ease;
	}
	.nav-brand-wand .wand-stop-a {
		stop-color: var(--color-accent);
	}
	.nav-brand-wand .wand-stop-b {
		stop-color: var(--color-warn);
	}
	.nav-brand-wand .wand-stop-c {
		stop-color: var(--color-danger);
	}
	.nav-brand-wand .wand-spark {
		transform-origin: center;
		transform-box: fill-box;
	}
	.nav-brand-wand .wand-spark-1 {
		fill: var(--color-accent);
		animation: nav-brand-spark 2.4s ease-in-out infinite;
	}
	.nav-brand-wand .wand-spark-2 {
		fill: var(--color-warn);
		animation: nav-brand-spark 2.8s ease-in-out 0.6s infinite;
	}
	.nav-brand-wand .wand-spark-3 {
		fill: var(--color-danger);
		animation: nav-brand-spark 3.2s ease-in-out 1.2s infinite;
	}

	@keyframes nav-brand-spark {
		0%,
		100% {
			opacity: 0.25;
			transform: scale(0.6);
		}
		50% {
			opacity: 1;
			transform: scale(1.15);
		}
	}

	.nav-brand-word {
		font-family: var(--font-crt);
		font-size: 22px;
		line-height: 1;
		letter-spacing: 0.02em;
		background: linear-gradient(
			90deg,
			var(--color-accent),
			var(--color-warn),
			var(--color-danger),
			var(--color-accent)
		);
		background-size: 300% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
		filter: drop-shadow(0 0 8px color-mix(in oklab, var(--color-accent) 35%, transparent));
		animation: nav-brand-shimmer 7s linear infinite;
	}

	@keyframes nav-brand-shimmer {
		0% {
			background-position: 0% 50%;
		}
		100% {
			background-position: 300% 50%;
		}
	}

	.nav-brand-version {
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text-dim);
		padding: 2px 6px;
		border: 1px solid var(--color-border);
		border-radius: 3px;
		margin-left: 0.15rem;
	}

	.nav-brand:hover .nav-brand-wand,
	.nav-brand:focus-visible .nav-brand-wand {
		transform: rotate(-12deg) scale(1.08);
		filter: drop-shadow(0 0 10px var(--color-accent));
	}
	.nav-brand:hover .nav-brand-word,
	.nav-brand:focus-visible .nav-brand-word {
		animation-duration: 3s;
	}

	@media (max-width: 640px) {
		.nav-brand-version {
			display: none;
		}
		.nav-brand-word {
			font-size: 20px;
		}
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.nav-divider {
		width: 1px;
		height: 22px;
		background: var(--color-border);
	}

	.nav-icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--tap-min);
		height: var(--tap-min);
		border-radius: 8px;
		color: var(--color-text-muted);
		transition:
			color 0.18s ease,
			background 0.18s ease;
	}
	.nav-icon-btn:hover,
	.nav-icon-btn:focus-visible {
		color: var(--color-accent);
		background: var(--color-accent-soft);
		outline: none;
	}
	.nav-icon {
		width: 18px;
		height: 18px;
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-skip,
		.nav-brand-wand,
		.nav-icon-btn,
		.nav-header {
			transition: none;
		}
		.nav-brand-word,
		.nav-brand-wand .wand-spark {
			animation: none;
		}
		.nav-brand-wand .wand-spark {
			opacity: 0.75;
		}
		.nav-brand:hover .nav-brand-wand,
		.nav-brand:focus-visible .nav-brand-wand {
			transform: none;
		}
	}
</style>
