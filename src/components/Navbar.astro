---
import { Icon } from 'astro-icon/components';
import ThemeSwitcher from './ThemeSwitcher.astro';

interface Props {
	githubUrl?: string;
	ariaLabel?: string;
}

const { githubUrl = '#', ariaLabel = 'Site' } = Astro.props;

// Trailing slashes vary depending on how the page is served, so normalise
// before comparing — otherwise /tui/ never matches /tui and the current page
// is never marked.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isLab = path === '/tui';
---

<a class="nav-skip" href="#main">Skip to content</a>

<header class="nav-header" data-nav-header>
	<nav class="nav-inner" aria-label={ariaLabel}>
		<a class="nav-brand" href="/" aria-label="magus.sh — home">
			<svg
				class="nav-brand-sigil"
				viewBox="0 0 128 128"
				fill="currentColor"
				aria-hidden="true"
				focusable="false"
			>
				<path
					d="M50.4 78.5a75.1 75.1 0 0 0-28.5 6.9l24.2-65.7c.7-2 1.9-3.2 3.4-3.2h29c1.5 0 2.7 1.2 3.4 3.2l24.2 65.7s-11.6-7-28.5-7L67 45.5c-.4-1.7-1.6-2.8-2.9-2.8-1.3 0-2.5 1.1-2.9 2.7L50.4 78.5Zm-1.1 28.2Zm-4.2-20.2c-2 6.6-.6 15.8 4.2 20.2a17.5 17.5 0 0 1 .2-.7 5.5 5.5 0 0 1 5.7-4.5c2.8.1 4.3 1.5 4.7 4.7.2 1.1.2 2.3.2 3.5v.4c0 2.7.7 5.2 2.2 7.4a13 13 0 0 0 5.7 4.9v-.3l-.2-.3c-1.8-5.6-.5-9.5 4.4-12.8l1.5-1a73 73 0 0 0 3.2-2.2 16 16 0 0 0 6.8-11.4c.3-2 .1-4-.6-6l-.8.6-1.6 1a37 37 0 0 1-22.4 2.7c-5-.7-9.7-2-13.2-6.2Z"
				></path>
			</svg>
			<span class="nav-brand-lockup" aria-hidden="true">
				<span class="nav-brand-magus">magus</span><span class="nav-brand-dot"></span><span class="nav-brand-sh">sh</span><span class="nav-brand-cursor">_</span>
			</span>
			<span class="nav-brand-version" aria-hidden="true">v0.1</span>
		</a>

		<div class="nav-actions">
			<a
				class="nav-link"
				href="/tui"
				data-current={isLab ? 'true' : 'false'}
				aria-current={isLab ? 'page' : undefined}
				aria-label="TUI prototype (lab)"
			>
				<span class="nav-link-tag">lab</span>
				<span class="nav-link-name">tui</span>
			</a>
			<span class="nav-divider nav-divider-lab" aria-hidden="true"></span>
			<a
				class="nav-icon-btn"
				href={githubUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub repository (opens in new tab)"
			>
				<Icon name="simple-icons:github" class="nav-icon" />
			</a>
			<span class="nav-divider" aria-hidden="true"></span>
			<ThemeSwitcher />
		</div>
	</nav>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-nav-header]');
	if (header) {
		const onScroll = () => {
			header.setAttribute('data-scrolled', window.scrollY > 4 ? 'true' : 'false');
		};
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>

<style>
	.nav-skip {
		position: fixed;
		top: 8px;
		left: 8px;
		z-index: 80;
		padding: 8px 14px;
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-accent);
		border-radius: 6px;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 12px;
		text-decoration: none;
		transform: translateY(-200%);
		transition: transform 0.18s ease;
	}
	.nav-skip:focus-visible {
		transform: translateY(0);
		outline: none;
	}

	.nav-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in oklab, var(--color-bg-elevated) 82%, transparent);
		backdrop-filter: blur(18px) saturate(140%);
		-webkit-backdrop-filter: blur(18px) saturate(140%);
		border-bottom: 1px solid var(--color-border);
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.nav-header[data-scrolled='true'] {
		border-bottom-color: var(--color-border-strong);
		box-shadow: 0 8px 24px -16px rgba(0, 0, 0, 0.55);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		max-width: 80rem;
		margin: 0 auto;
		height: 56px;
		padding: 0 20px;
	}
	@media (min-width: 768px) {
		.nav-inner {
			height: 64px;
		}
	}

	.nav-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		isolation: isolate;
		color: var(--color-accent);
	}
	.nav-brand:focus-visible {
		outline: none;
	}

	.nav-brand-sigil {
		width: 22px;
		height: 22px;
		flex-shrink: 0;
		color: var(--color-accent);
		filter: drop-shadow(0 0 8px color-mix(in oklab, var(--color-accent) 38%, transparent));
		transition:
			transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
			filter 0.25s ease;
	}

	.nav-brand-lockup {
		display: inline-flex;
		align-items: baseline;
		gap: 0;
		line-height: 1;
	}

	.nav-brand-magus {
		font-family: "Major Mono Display", var(--font-mono);
		font-weight: 400;
		font-size: 18px;
		letter-spacing: -0.02em;
		text-transform: lowercase;
		color: var(--color-text);
		text-shadow:
			0 1px 0 color-mix(in oklab, var(--color-bg) 80%, black 20%),
			0 4px 14px color-mix(in oklab, var(--color-accent) 18%, transparent);
	}

	.nav-brand-dot {
		display: inline-block;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--color-accent);
		margin: 0 0.22em 0.18em;
		box-shadow: 0 0 8px color-mix(in oklab, var(--color-accent) 60%, transparent);
		align-self: baseline;
		transform: translateY(-0.05em);
	}

	.nav-brand-sh {
		font-family: var(--font-crt);
		font-size: 22px;
		color: var(--color-accent);
		line-height: 1;
		letter-spacing: 0.02em;
		text-transform: lowercase;
		text-shadow:
			0 0 6px color-mix(in oklab, var(--color-accent) 55%, transparent),
			0 0 18px color-mix(in oklab, var(--color-accent) 28%, transparent),
			0 0 36px color-mix(in oklab, var(--color-accent) 14%, transparent);
	}

	.nav-brand-cursor {
		display: inline-block;
		font-family: var(--font-crt);
		font-size: 22px;
		color: var(--color-accent);
		margin-left: 0.04em;
		line-height: 1;
		animation: nav-brand-blink 1.05s steps(2, jump-none) infinite;
		text-shadow:
			0 0 6px color-mix(in oklab, var(--color-accent) 55%, transparent),
			0 0 18px color-mix(in oklab, var(--color-accent) 28%, transparent);
	}

	@keyframes nav-brand-blink {
		0%, 50% { opacity: 1; }
		51%, 100% { opacity: 0; }
	}

	.nav-brand-version {
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text-dim);
		padding: 2px 6px;
		border: 1px solid var(--color-border);
		border-radius: 3px;
		margin-left: 0.15rem;
	}

	.nav-brand:hover .nav-brand-sigil,
	.nav-brand:focus-visible .nav-brand-sigil {
		transform: rotate(-6deg) scale(1.08);
		filter: drop-shadow(0 0 12px var(--color-accent));
	}

	@media (max-width: 640px) {
		.nav-brand-version {
			display: none;
		}
		.nav-brand-magus,
		.nav-brand-sh,
		.nav-brand-cursor {
			font-size: 18px;
		}
		.nav-brand-magus {
			font-size: 16px;
		}
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.nav-divider {
		width: 1px;
		height: 22px;
		background: var(--color-border);
	}

	.nav-link {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		min-height: var(--tap-min);
		padding: 0 10px;
		border-radius: 8px;
		text-decoration: none;
		color: var(--color-text-muted);
		align-self: center;
		transition:
			color 0.18s ease,
			background 0.18s ease;
	}
	.nav-link:hover,
	.nav-link:focus-visible {
		color: var(--color-accent);
		background: var(--color-accent-soft);
		outline: none;
	}
	.nav-link[data-current='true'] {
		color: var(--color-accent);
	}
	.nav-link-tag {
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text-dim);
	}
	.nav-link[data-current='true'] .nav-link-tag {
		color: inherit;
	}
	.nav-link-name {
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.02em;
	}
	/* The bar is tight on a phone: brand, link, GitHub and the theme switcher.
	   Shed the link's chrome — tag first, then its divider and padding — rather
	   than let the theme switcher get clipped off the right edge. */
	@media (max-width: 480px) {
		.nav-link-tag {
			display: none;
		}
		.nav-divider-lab {
			display: none;
		}
		.nav-link {
			padding: 0 4px;
		}
		.nav-actions {
			gap: 6px;
		}
	}

	.nav-icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--tap-min);
		height: var(--tap-min);
		border-radius: 8px;
		color: var(--color-text-muted);
		transition:
			color 0.18s ease,
			background 0.18s ease;
	}
	.nav-icon-btn:hover,
	.nav-icon-btn:focus-visible {
		color: var(--color-accent);
		background: var(--color-accent-soft);
		outline: none;
	}
	.nav-icon {
		width: 18px;
		height: 18px;
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-skip,
		.nav-brand-sigil,
		.nav-icon-btn,
		.nav-header {
			transition: none;
		}
		.nav-brand-cursor {
			animation: none;
		}
		.nav-brand:hover .nav-brand-sigil,
		.nav-brand:focus-visible .nav-brand-sigil {
			transform: none;
		}
	}
</style>
