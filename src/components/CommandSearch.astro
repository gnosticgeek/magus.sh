---
import { Icon } from 'astro-icon/components';
---

<div class="cmd-search" role="search">
	<Icon name="lucide:search" class="cmd-search-icon" aria-hidden="true" />
	<input
		id="cmd-search-input"
		type="search"
		inputmode="search"
		autocomplete="off"
		spellcheck="false"
		placeholder="Find a command…"
		aria-label="Filter commands"
		class="cmd-search-input"
	/>
	<kbd class="cmd-search-kbd" aria-hidden="true">/</kbd>
	<button
		type="button"
		class="cmd-search-clear"
		aria-label="Clear search"
		hidden
	>
		<Icon name="lucide:x" aria-hidden="true" />
	</button>
</div>

<div id="cmd-search-empty" class="cmd-search-empty" hidden role="status" aria-live="polite">
	<p>
		Nothing matches <span class="cmd-search-empty-term"></span>.
	</p>
	<button type="button" class="cmd-search-reset">show all commands</button>
</div>

<script>
	const input = document.getElementById('cmd-search-input') as HTMLInputElement | null;
	const clearBtn = document.querySelector<HTMLButtonElement>('.cmd-search-clear');
	const emptyState = document.getElementById('cmd-search-empty');
	const emptyTerm = emptyState?.querySelector<HTMLElement>('.cmd-search-empty-term');
	const resetBtn = emptyState?.querySelector<HTMLButtonElement>('.cmd-search-reset');

	if (input && clearBtn && emptyState && emptyTerm && resetBtn) {
		const cards = Array.from(document.querySelectorAll<HTMLElement>('.card[data-search]'));
		const sections = Array.from(document.querySelectorAll<HTMLElement>('section.stage'));

		const filter = (raw: string) => {
			const term = raw.trim().toLowerCase();
			clearBtn.hidden = term.length === 0;

			let visibleCount = 0;
			for (const card of cards) {
				const matches = term === '' || (card.dataset.search ?? '').includes(term);
				card.classList.toggle('search-hidden', !matches);
				if (matches) visibleCount++;
			}

			/* When a search is active, reveal every stage so users see all matches
			   regardless of which stage is "active" via the hash router. */
			if (term === '') {
				document.documentElement.classList.remove('searching');
			} else {
				document.documentElement.classList.add('searching');
				for (const section of sections) {
					section.hidden = false;
				}
			}

			emptyTerm.textContent = `"${raw}"`;
			emptyState.hidden = visibleCount > 0 || term === '';
		};

		input.addEventListener('input', () => filter(input.value));

		clearBtn.addEventListener('click', () => {
			input.value = '';
			filter('');
			input.focus();
		});

		resetBtn.addEventListener('click', () => {
			input.value = '';
			filter('');
			input.focus();
		});

		/* "/" focuses the search like a power user shortcut. Skip when the
		   user is already typing into something else or chording a modifier. */
		document.addEventListener('keydown', (e) => {
			if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
			const active = document.activeElement as HTMLElement | null;
			if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.isContentEditable)) return;
			e.preventDefault();
			input.focus();
			input.select();
		});

		/* Esc clears + blurs when the input is focused */
		input.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				input.value = '';
				filter('');
				input.blur();
			}
		});
	}
</script>

<style>
	.cmd-search {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 10px 0 12px;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: color-mix(in oklab, var(--color-bg) 70%, transparent);
		min-height: var(--tap-min);
		transition: border-color 0.18s ease, background-color 0.18s ease;
	}
	.cmd-search:focus-within {
		border-color: var(--color-accent);
		background: var(--color-bg);
		box-shadow: 0 0 0 3px var(--color-accent-soft);
	}
	.cmd-search-icon {
		width: 14px;
		height: 14px;
		color: var(--color-text-dim);
		flex-shrink: 0;
	}
	.cmd-search:focus-within .cmd-search-icon {
		color: var(--color-accent);
	}
	.cmd-search-input {
		flex: 1;
		min-width: 0;
		background: transparent;
		border: 0;
		outline: 0;
		padding: 8px 0;
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.01em;
		color: var(--color-text);
		caret-color: var(--color-accent);
	}
	.cmd-search-input::placeholder {
		color: var(--color-text-dim);
		font-family: var(--font-sans);
	}
	.cmd-search-input::-webkit-search-cancel-button {
		display: none;
	}
	.cmd-search-kbd {
		font-family: var(--font-mono);
		font-size: 10px;
		padding: 2px 5px;
		border: 1px solid var(--color-border-strong);
		border-radius: 4px;
		color: var(--color-text-dim);
		background: var(--color-surface);
		line-height: 1;
		flex-shrink: 0;
	}
	.cmd-search:focus-within .cmd-search-kbd {
		display: none;
	}
	.cmd-search-clear {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		border: 0;
		background: transparent;
		color: var(--color-text-dim);
		cursor: pointer;
		border-radius: 4px;
		flex-shrink: 0;
		transition: color 0.15s ease, background 0.15s ease;
	}
	.cmd-search-clear :global(svg) {
		width: 14px;
		height: 14px;
	}
	.cmd-search-clear:hover {
		color: var(--color-accent);
		background: var(--color-accent-soft);
	}

	@media (max-width: 479px) {
		.cmd-search-kbd {
			display: none;
		}
	}

	.cmd-search-empty {
		margin: 1.5rem auto 0;
		padding: 2rem 1rem;
		text-align: center;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--color-text-muted);
	}
	.cmd-search-empty p {
		margin: 0 0 0.85rem;
	}
	.cmd-search-empty-term {
		color: var(--color-accent);
	}
	.cmd-search-reset {
		font-family: var(--font-mono);
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		padding: 8px 14px;
		border: 1px solid var(--color-border-strong);
		border-radius: 6px;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
		min-height: var(--tap-min);
	}
	.cmd-search-reset:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
</style>
