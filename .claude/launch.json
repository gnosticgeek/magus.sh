{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "magus-sh-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 4321,
      "autoPort": true
    },
    {
      "name": "magus-gui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "gui", "run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "magus-sh-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "dist/client", "-p", "4322", "--no-clipboard"],
      "port": 4322,
      "autoPort": true
    }
  ]
}
