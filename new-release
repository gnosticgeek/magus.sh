#!/bin/sh

# Prepare the next patch release in a sibling Git worktree.
#
# Usage:
#   ./new-release
#   ./new-release --dry-run
#   ./new-release --from v0.5.0 --dry-run

set -eu

die() {
	printf 'new-release: %s\n' "$*" >&2
	exit 1
}

dry_run=false
from_version=""

while [ "$#" -gt 0 ]; do
	case "$1" in
	--dry-run)
		dry_run=true
		;;
	--from)
		[ "$#" -ge 2 ] || die "--from needs a version such as v0.5.0"
		from_version=$2
		shift
		;;
	-h | --help)
		sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	*)
		die "unknown option: $1"
		;;
	esac
	shift
done

command -v git >/dev/null 2>&1 || die "git is required"

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "run this inside the Magus repository"
git_dir=$(git -C "$repo_root" rev-parse --git-common-dir)
case "$git_dir" in
/*) ;;
*) git_dir="$repo_root/$git_dir" ;;
esac
primary_root=$(cd "$(dirname "$git_dir")" && pwd -P)

origin_url=$(git -C "$repo_root" remote get-url origin 2>/dev/null) || die "the repository has no origin remote"
case "$origin_url" in
https://github.com/*)
	github_repo=${origin_url#https://github.com/}
	;;
git@github.com:*)
	github_repo=${origin_url#git@github.com:}
	;;
*)
	die "origin must point to a GitHub repository"
	;;
esac
github_repo=${github_repo%.git}

if [ -z "$from_version" ]; then
	command -v curl >/dev/null 2>&1 || die "curl is required to find the latest published release"
	from_version=$(curl --proto '=https' --tlsv1.2 -fsSL \
		"https://api.github.com/repos/$github_repo/releases/latest" |
		sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' |
		head -n 1)
	[ -n "$from_version" ] || die "could not find the latest published GitHub release"
fi

version=${from_version#v}
old_ifs=$IFS
IFS=.
set -- $version
IFS=$old_ifs
[ "$#" -eq 3 ] || die "latest release is not vMAJOR.MINOR.PATCH: $from_version"
major=$1
minor=$2
patch=$3
case "$major$minor$patch" in
*[!0-9]*) die "latest release is not numeric: $from_version" ;;
esac

next_patch=$((patch + 1))
next_version="$major.$minor.$next_patch"
branch="codex/release-$next_version"
repo_name=$(basename "$primary_root")
repo_name=${repo_name%.sh}
worktree="$(dirname "$primary_root")/$repo_name-$next_version"

if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
	die "branch already exists: $branch"
fi
[ ! -e "$worktree" ] || die "path already exists: $worktree"

printf 'Latest release: %s\n' "$from_version"
printf 'Next release:   v%s\n' "$next_version"
printf 'Branch:         %s\n' "$branch"
printf 'Worktree:       %s\n' "$worktree"

if [ "$dry_run" = true ]; then
	printf '\nDry run: nothing changed.\n'
	exit 0
fi

printf '\nRefreshing origin/main...\n'
git -C "$repo_root" fetch origin main

# Recheck after fetching so a concurrent release setup cannot be overwritten.
if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
	die "branch appeared while refreshing: $branch"
fi
[ ! -e "$worktree" ] || die "path appeared while refreshing: $worktree"

git -C "$repo_root" worktree add -b "$branch" "$worktree" origin/main

printf '\nReady. Start the new release task in:\n%s\n' "$worktree"
