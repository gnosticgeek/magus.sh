{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "magus",
  "version": "0.1.0",
  "identifier": "sh.magus.gui",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "magus",
        "width": 720,
        "height": 620,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "shortDescription": "The first hour of owning a Steam Deck or Steam Machine",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
