{
  "name": "magus-sh",
  "type": "module",
  "version": "0.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "prebuild": "astro check",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "test": "vitest run",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "magus": "cd magus && go run .",
    "magus:gen": "tsx magus/scripts/gen-commands.mts",
    "magus:build": "cd magus && go build -o magus ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify-json/lucide": "^1.2.130",
    "@iconify-json/simple-icons": "^1.2.95",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "astro-icon": "^1.2.0",
    "gray-matter": "^4.0.3",
    "tailwindcss": "^4.3.3"
  }
}
