{
  "name": "magus-sh",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "prebuild": "astro check",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "test": "vitest run",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "magus": "cd magus && go run .",
    "magus:gen": "tsx magus/scripts/gen-commands.mts",
    "magus:build": "cd magus && go build -o magus ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/mdx": "^7.0.5",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.2.0",
    "astro-icon": "^1.1.5",
    "gray-matter": "^4.0.3",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@iconify-json/lucide": "^1.2.106",
    "@iconify-json/simple-icons": "^1.2.81",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.90.1"
  }
}
